  "server_argv": [
    "serve",
    "${model}",
    "--kernel-target=glm-5.3-flash",
    "--world-size=2",
    "--tp-size=2",
    "--ep-size=2",
    "--max-seq-len=200000",
    "--gpu-memory-utilization=0.88",
    "--max-prefill-tokens=1024",
    "--max-batch-size=1",
    "--max-num-seqs=1",
    "--oom-guard-mb=4096",
    "--kv-cache-dtype=fp8_g128",
    "--ssm-h-dtype=f32",
    "--ssm-rollback-mode=records",
    "--block-size=16",
    "--ssm-cache-slots=0",
    "--enable-prefix-caching=false",
    "--ssm-checkpoint-interval=0",
    "--gpu-ordinal=0",
    "--swap-space-gb=0",
    "--no-auto-swap",
    "--no-tui",
    "--lm-head-dtype=bf16",
    "--request-timeout=0",
    "--tool-call-parser=poolside_v1",
    "--lora-adapter=heretic=/adapter",
    "--max-loras=1",
    "--max-lora-rank=8"
  ]
