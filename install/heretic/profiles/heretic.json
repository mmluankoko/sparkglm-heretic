{
  "schema": "onlineheretic.sparkglm-profile/v1",
  "status": "mvp-eager-no-spec-single-sequence",
  "environment": {
    "ATLAS_GLM_HERETIC": "1",
    "ATLAS_LORA_EXPERTS": "1",
    "ATLAS_LORA_EXPERT_RANK": "8",
    "ATLAS_LORA_EAGER": "1",
    "ATLAS_GLM_EXPERT_TP": "1",
    "ATLAS_EP_PROTOCOL": "v2",
    "ATLAS_KV_MAX_BLOCKS": "12500",
    "ATLAS_DEBUG_NO_GRAPH": "1",
    "ATLAS_NO_DECODE_GRAPHS": "1",
    "ATLAS_NO_DECODE_GRAPHS_MULTISEQ": "1",
    "ATLAS_EP_GRAPHS": "0",
