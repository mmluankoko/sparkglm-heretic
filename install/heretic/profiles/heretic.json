    "ATLAS_GLM_KV_CANONICAL": "1",
    "ATLAS_GLM_SPARSE_NATIVE": "0",
    "ATLAS_GLM_SPARSE_PREFILL_TC": "1",
    "ATLAS_GLM_SPARSE_PREFILL_KV_REUSE": "1",
    "ATLAS_KDA_FLASH_PREFILL": "0",
    "ATLAS_GLM_TARGET_SHARED_FP8": "0",
    "ATLAS_GLM_TARGET_SHARED_FP8_VERIFY": "0",
    "ATLAS_GLM_MLA_FUSE": "0",
    "ATLAS_GLM_MLA_MXFP8": "0",
    "ATLAS_GLM_LM_HEAD_MXFP8": "0",
    "ATLAS_GLM_SHARED_TP_SPLIT": "0",
    "ATLAS_GLM_DENSE_TP_SPLIT": "0",
    "ATLAS_GLM_C4_DECODE": "0",
    "ATLAS_GLM_C4_SPARSE": "0",
    "ATLAS_GLM_INDEPENDENT_DECODE": "0",
    "ATLAS_GLM_MULTI_SEQ_SPARSE": "0",
    "ATLAS_GLM_MULTI_SEQ_SPARSE_GRAPHS": "0",
    "ATLAS_MOE_SHARED_REDUCE_OVERLAP": "0",
    "ATLAS_NVFP4_FUSED_SILU_QUANT": "0",
    "ATLAS_NVFP4_PREQUANT_MOE": "1",
    "ATLAS_UNIFIED_MOE_LAYOUT": "1",
    "ATLAS_W4A16_TC": "1",
    "ATLAS_CUBLAS_GEMM": "1",
    "ATLAS_BF16_GEMM_CUTLASS": "1",
    "ATLAS_RDMA_ALLREDUCE": "0",
    "CUDA_CACHE_PATH": "/cache/cuda",
    "RUST_LOG": "info",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_ADDR_FAMILY": "AF_INET",
    "NCCL_IB_ROCE_VERSION_NUM": "2",
    "NCCL_DEBUG": "WARN",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_CUMEM_HOST_ENABLE": "0",
    "NCCL_DMABUF_ENABLE": "0",
    "NCCL_NVLS_ENABLE": "0"
