@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Fixed GLM adapter installation; projection deltas never mutate base weights.
+
+use super::*;
+use crate::layers::ops::lora_delta::{LoraKernels, LoraPair};
+
+impl Glm5KdaLayer {
+    pub(super) fn check_lora_pass(&self, verify: bool, ctx: &ForwardContext) -> Result<()> {
+        if self.lora_o.is_some() && crate::layers::glm_lora::active(ctx)? {
+            ensure!(
+                !verify
+                    || crate::layers::glm_lora::dflash_context(
+                        ctx,
+                        ctx.host_token_ids.map_or(0, <[u32]>::len)
+                    ),
+                "GLM KDA LoRA verification requires an admitted single-owner DFlash context"
+            );
+        }
+        Ok(())
+    }
+
+    pub(super) fn apply_o_lora(
+        &self,
+        input: DevicePtr,
+        output: DevicePtr,
+        rows: u32,
+        ctx: &ForwardContext,
+        stream: u64,
+    ) -> Result<()> {
+        if let Some((pair, kernels)) = &self.lora_o {
+            crate::layers::glm_lora::apply(
+                pair,
+                kernels,
+                input,
+                output,
+                rows,
+                (self.heads * self.dim) as u32,
+                self.hidden_size as u32,
+                ctx,
+                stream,
+            )?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn set_lora_weights(
+        &mut self,
+        pair: Option<LoraPair>,
+        kernels: LoraKernels,
+    ) -> Result<()> {
+        if let Some(p) = pair {
+            ensure!(
+                p.k_in as usize == self.heads * self.dim && p.n_out as usize == self.hidden_size,
+                "GLM KDA LoRA O projection does not match this TP shard"
+            );
+        }
+        self.lora_o = pair.map(|p| (p, kernels));
+        Ok(())
+    }
+
+    pub(crate) fn set_moe_lora_weights(
+        &mut self,
+        router: Option<LoraPair>,
+        experts: crate::lora::ExpertLoraLayer,
+        kernels: LoraKernels,
+        gpu: &dyn GpuBackend,
+    ) -> Result<()> {
+        match &mut self.ffn {
+            FfnComponent::Moe(m) => m.set_lora_weights(router, experts, kernels, gpu),
+            _ => anyhow::bail!("GLM KDA expert LoRA requires a MoE FFN"),
+        }
+    }
+
+    pub(crate) fn set_shared_lora_weights(
+        &mut self,
+        full: Option<LoraPair>,
+        split: Option<LoraPair>,
+        kernels: LoraKernels,
+        gpu: &dyn GpuBackend,
+    ) -> Result<()> {
+        match &mut self.ffn {
+            FfnComponent::Moe(m) => m.set_shared_lora_weights(full, split, kernels, gpu),
+            _ => anyhow::bail!("GLM KDA shared LoRA requires a MoE FFN"),
+        }
+    }
+}
