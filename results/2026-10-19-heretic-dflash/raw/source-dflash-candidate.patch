+++ b/crates/spark-model/examples/glm_heretic_lora_math/compact.rs
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+// Included inside the existing CUDA oracle; never executes during a build.
+use super::{GpuBackend, LoraKernels, Result, ensure, grouped};
+
+pub(super) fn run(gpu: &dyn GpuBackend, kernels: &LoraKernels) -> Result<()> {
+    let mut original = *kernels;
+    original.moe_compact_enabled = false;
+    let mut compact = *kernels;
+    compact.moe_compact_enabled = true;
+    let cases = [
+        (1, false, false, false, false),
+        (8, false, false, false, false),
+        (31, false, false, false, false),
+        (31, true, false, false, false),
+        (64, true, false, false, false),
+        (65, true, false, false, false), // fallback first windows, compact tail
+        (31, true, false, true, false),  // every owning token is base
+        (31, false, false, false, true), // pointer table ends before routed rows
+        (31, true, false, false, true),
+        (31, true, true, false, false), // x_gather must retain original dispatch
+    ];
+    for (cap, masked, gather, all_base, truncated) in cases {
+        let expected = grouped(
+            gpu, &original, 1024, cap, masked, gather, all_base, truncated,
+        )?;
+        let got = grouped(
+            gpu, &compact, 1024, cap, masked, gather, all_base, truncated,
+        )?;
+        ensure!(
+            got == expected,
+            "compact/original BF16 mismatch: window={cap} masked={masked} gather={gather} all_base={all_base} truncated={truncated}"
+        );
+        println!(
+            "PASS compact/original bitwise: window={cap} masked={masked} gather={gather} all_base={all_base} truncated={truncated}"
+        );
+    }
+    Ok(())
+}
diff --git a/crates/spark-model/examples/glm_heretic_lora_math/pair.rs b/crates/spark-model/examples/glm_heretic_lora_math/pair.rs
new file mode 100644
index 0000000..165325e
--- /dev/null
+++ b/crates/spark-model/examples/glm_heretic_lora_math/pair.rs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+// Prepared for an explicitly approved GPU run; building never executes it.
+use super::*;
+
+pub(super) fn run(gpu: &dyn GpuBackend, kernels: &LoraKernels) -> Result<()> {
+    for k in [1024, 2048, 4096, 8192] {
+        let mut rng = Rng(0xDFA5_0100 + k as u64);
+        let pair = Pair::new(k, -0.75, &mut rng);
+        let x = rng.values(8 * k, 0.25);
+        let initial = rng.values(9 * H, 0.015625);
+        let mut arena = Arena::new(gpu);
+        let weights = pair.upload(&mut arena, k)?;
+        let dx = arena.bf16(&x)?;
+        let reference = arena.bf16(&initial)?;
+        let reference_xa = arena.bf16(&vec![GUARD; 9 * R])?;
+        let scratch_delta = arena.bf16(&vec![GUARD; H])?;
+        for row in 0..8 {
+            apply_lora_delta(
+                gpu,
+                kernels,
+                &weights,
+                dx.offset(row * k * 2),
+                reference.offset(row * H * 2),
+                1,
+                reference_xa.offset(row * R * 2),
+                scratch_delta,
+                gpu.default_stream(),
+            )?;
+        }
+        gpu.synchronize(gpu.default_stream())?;
+        let expected = arena.read(reference, 9 * H)?;
+        let expected_xa = arena.read(reference_xa, 9 * R)?;
+        for width in 1..=8 {
+            let output = arena.bf16(&initial)?;
+            let xa = arena.bf16(&vec![GUARD; 9 * R])?;
+            spark_model::layers::ops::lora_pair_rows::apply(
+                gpu,
+                kernels,
+                &weights,
+                dx,
+                output,
+                width as u32,
+                xa,
+                gpu.default_stream(),
+            )?;
+            gpu.synchronize(gpu.default_stream())?;
+            let got = arena.read(output, 9 * H)?;
+            let got_xa = arena.read(xa, 9 * R)?;
+            ensure!(
+                got[..width * H] == expected[..width * H],
+                "direct-pair/m1 BF16 output differs: K={k} rows={width}"
+            );
+            ensure!(
+                got[width * H..] == initial[width * H..],
+                "direct-pair output guard overwritten: K={k} rows={width}"
+            );
+            ensure!(
+                got_xa[..width * R] == expected_xa[..width * R],
+                "direct-pair/m1 BF16 shrink differs: K={k} rows={width}"
+            );
+            ensure!(
+                got_xa[width * R..].iter().all(|&v| v == GUARD),
+                "direct-pair shrink guard overwritten: K={k} rows={width}"
+            );
+            check_padding(&got_xa[..width * R])?;
+            let mut want = Vec::with_capacity(width * H);
+            let mut magnitudes = Vec::with_capacity(width * H);
+            for row in 0..width {
+                let shrink = pair.shrink(&x[row * k..(row + 1) * k]);
+                for col in 0..H {
+                    let base = value(initial[row * H + col]);
+                    let delta = pair.delta(shrink, col);
+                    want.push(rounded(base + pair.scale * delta));
+                    magnitudes.push(base.abs() + (pair.scale * delta).abs());
+                }
+            }
+            compare(
+                &format!("direct-pair K={k} rows={width}"),
+                &got[..width * H],
+                &want,
+                Some(&magnitudes),
+            )?;
+            println!("PASS direct-pair/m1 bitwise + row guards: K={k} rows={width}");
+        }
+    }
+    Ok(())
+}
