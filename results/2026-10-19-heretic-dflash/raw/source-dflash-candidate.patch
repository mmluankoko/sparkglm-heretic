 }
+
+pub(super) fn ep_broadcast_adapter_for_seq<M: Model + ?Sized>(
+    model: &M,
+    seq: &SequenceState,
+) -> Result<()> {
+    // Preserve the original wire transcript when no adapter pool is loaded.
+    if model.adapter_id_for(crate::lora::DEFAULT_SLOT) == 0 {
+        return Ok(());
+    }
+    let words = crate::lora::encode_identity(seq.adapter_slot, seq.adapter_id)
+        .map_err(anyhow::Error::msg)?;
+    model.ep_broadcast_cmd_for_seq(seq.slot_idx as u32, crate::lora::EP_CMD_ADAPTER_IDENTITY)?;
+    for word in words {
+        model.ep_broadcast_cmd(word)?;
+    }
+    if seq.seq_len == 0 {
+        tracing::info!(
+            sequence = seq.slot_idx,
+            adapter_slot = seq.adapter_slot,
+            adapter_id = seq.adapter_id,
+            "TP adapter identity sent"
+        );
+    }
+    Ok(())
+}
