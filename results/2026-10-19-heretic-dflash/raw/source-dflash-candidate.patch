@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Pure admission boundary for the first single-owner Heretic DFlash launch.
+
+#[derive(Clone, Copy)]
+pub(super) struct DflashLaunch<'a> {
+    pub dual: bool,
+    pub adapter: &'a str,
+    pub dflash: bool,
+    pub other_speculation: bool,
+    pub gamma: usize,
+    pub force_gate: bool,
+    pub prefill_verify: bool,
+    pub first_append_none: bool,
+    pub eager: bool,
+    pub no_sp: bool,
+    pub no_prefix: bool,
+    pub f32_records: bool,
+    pub no_hss: bool,
+    pub canonical: bool,
+    pub canonical_kv: bool,
+    pub canonical_head: bool,
+    pub no_owner_batch: bool,
+}
+
+impl DflashLaunch<'_> {
+    pub(super) fn validate(&self) -> Result<(), &'static str> {
+        for (valid, reason) in [
+            (
+                self.dual && self.adapter == "heretic",
+                "requires the fixed GLM TP2/EP2 launch with the sole resident adapter named heretic",
+            ),
+            (
+                self.dflash && !self.other_speculation,
+                "requires --dflash, ATLAS_GLM_DFLASH=1, ATLAS_GLM_MTP_LONG_CONTEXT=1 and no other speculative mode",
+            ),
+            (
+                (2..=8).contains(&self.gamma),
+                "requires DFlash gamma in 2..=8",
+            ),
+            (
+                self.force_gate,
+                "requires --mtp-gate=force (the DFlash scheduler gate)",
+            ),
+            (
+                self.prefill_verify,
+                "requires ATLAS_GLM_DFLASH_PREFILL_VERIFY=1",
+            ),
+            (
+                self.first_append_none,
+                "requires ATLAS_DFLASH_FIRST_APPEND=none",
+            ),
+            (
+                self.eager,
+                "requires eager execution with all decode/EP graphs disabled",
+            ),
+            (self.no_sp, "requires ATLAS_GLM_PREFILL_SP=0"),
+            (
+                self.no_prefix,
+                "requires prefix caching and SSM cache/checkpoints disabled",
+            ),
+            (
+                self.f32_records,
+                "requires --ssm-h-dtype=f32 --ssm-rollback-mode=records",
+            ),
+            (self.no_hss, "requires high-speed swap disabled"),
+            (
+                self.canonical,
+                "requires ATLAS_GLM_CANONICAL_VERIFY=1 ATLAS_W4A16_TC=1",
+            ),
+            (
+                self.canonical_kv,
+                "requires canonical FP8 KV, prefill TC and KV reuse",
+            ),
+            (
+                self.canonical_head,
+                "requires ATLAS_GLM_LM_HEAD_MXFP8=1 ATLAS_GLM_VERIFY_VOCAB_SPLIT=1",
+            ),
+            (
+                self.no_owner_batch,
+                "requires ATLAS_GLM_LONG_BATCH_VERIFY=0 (single-owner verification)",
+            ),
+        ] {
+            if !valid {
+                return Err(reason);
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::DflashLaunch;
+
+    fn valid() -> DflashLaunch<'static> {
+        DflashLaunch {
+            dual: true,
+            adapter: "heretic",
+            dflash: true,
+            other_speculation: false,
+            gamma: 8,
+            force_gate: true,
+            prefill_verify: true,
+            first_append_none: true,
+            eager: true,
+            no_sp: true,
+            no_prefix: true,
+            f32_records: true,
+            no_hss: true,
+            canonical: true,
+            canonical_kv: true,
+            canonical_head: true,
+            no_owner_batch: true,
+        }
+    }
+
+    #[test]
+    fn bounded_heretic_dflash_is_admitted() {
+        for gamma in 2..=8 {
+            assert!(DflashLaunch { gamma, ..valid() }.validate().is_ok());
+        }
+    }
+
+    #[test]
+    fn rejects_every_missing_boundary() {
+        let good = valid();
+        for invalid in [
+            DflashLaunch {
+                dual: false,
+                ..good
+            },
+            DflashLaunch {
+                adapter: "other",
+                ..good
+            },
+            DflashLaunch {
+                dflash: false,
+                ..good
+            },
+            DflashLaunch {
+                other_speculation: true,
+                ..good
+            },
+            DflashLaunch { gamma: 0, ..good },
+            DflashLaunch { gamma: 1, ..good },
+            DflashLaunch { gamma: 9, ..good },
+            DflashLaunch {
+                force_gate: false,
+                ..good
+            },
+            DflashLaunch {
+                prefill_verify: false,
+                ..good
+            },
+            DflashLaunch {
+                first_append_none: false,
+                ..good
+            },
+            DflashLaunch {
+                eager: false,
+                ..good
+            },
+            DflashLaunch {
+                no_sp: false,
+                ..good
+            },
+            DflashLaunch {
+                no_prefix: false,
+                ..good
+            },
+            DflashLaunch {
+                f32_records: false,
+                ..good
+            },
+            DflashLaunch {
+                no_hss: false,
+                ..good
+            },
+            DflashLaunch {
+                canonical: false,
+                ..good
+            },
+            DflashLaunch {
+                canonical_kv: false,
+                ..good
+            },
+            DflashLaunch {
+                canonical_head: false,
+                ..good
+            },
+            DflashLaunch {
+                no_owner_batch: false,
+                ..good
+            },
+        ] {
+            assert!(invalid.validate().is_err());
+        }
+    }
+}
