+++ b/crates/spark-model/src/layers/ops/lora_pair_rows.rs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! One installed pair over temporal rows, with the m1 BGMV reduction for all K.
+
+use anyhow::{Result, ensure};
+use spark_runtime::gpu::{DevicePtr, GpuBackend};
+use spark_runtime::kernel_args::{KernelLaunch, div_ceil};
+
+use super::lora_delta::{LoraKernels, LoraPair};
+
+#[allow(clippy::too_many_arguments)]
+pub fn apply(
+    gpu: &dyn GpuBackend,
+    kernels: &LoraKernels,
+    pair: &LoraPair,
+    input: DevicePtr,
+    output: DevicePtr,
+    rows: u32,
+    xa: DevicePtr,
+    stream: u64,
+) -> Result<()> {
+    ensure!(
+        (1..=8).contains(&rows)
+            && pair.rank == 1
+            && pair.max_rank == 8
+            && pair.n_out == 4096
+            && [1024, 2048, 4096, 8192].contains(&pair.k_in),
+        "DFlash direct-pair LoRA requires the admitted r1/pad8 GLM geometry"
+    );
+    ensure!(
+        kernels.pair_shrink_k.0 != 0 && kernels.pair_expand_fold_k.0 != 0,
+        "DFlash direct-pair LoRA kernels are not installed"
+    );
+    KernelLaunch::new(gpu, kernels.pair_shrink_k)
+        .grid([div_ceil(pair.max_rank, 4), rows, 1])
+        .block([256, 1, 1])
+        .arg_ptr(input)
+        .arg_ptr(pair.a.weight)
+        .arg_ptr(xa)
+        .arg_u32(rows)
+        .arg_u32(pair.max_rank)
+        .arg_u32(pair.k_in)
+        .arg_u32(pair.k_in)
+        .launch(stream)?;
+    KernelLaunch::new(gpu, kernels.pair_expand_fold_k)
+        .grid([div_ceil(pair.n_out, 4), rows, 1])
+        .block([256, 1, 1])
+        .arg_ptr(xa)
+        .arg_ptr(pair.b.weight)
+        .arg_f32(pair.scale)
+        .arg_ptr(output)
+        .arg_u32(rows)
+        .arg_u32(pair.n_out)
+        .arg_u32(pair.max_rank)
+        .arg_u32(pair.n_out)
+        .launch(stream)
+}
diff --git a/crates/spark-model/src/layers/ops/moe_lora_compact.rs b/crates/spark-model/src/layers/ops/moe_lora_compact.rs
new file mode 100644
index 0000000..b471133
--- /dev/null
+++ b/crates/spark-model/src/layers/ops/moe_lora_compact.rs
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Pure dispatch boundary for the opt-in GLM small-window grouped LoRA fold.
+
+/// Parse once at adapter-kernel construction; malformed values fail startup.
+pub fn parse_requested(value: Option<&str>) -> Result<bool, String> {
+    match value {
+        None | Some("0") => Ok(false),
+        Some("1") => Ok(true),
+        Some(value) => Err(format!(
+            "ATLAS_GLM_LORA_COMPACT must be 0 or 1, got {value:?}"
+        )),
+    }
+}
+
+/// Exact row grid for the reviewed TP2 GLM down-projection shape. Wider,
+/// empty, reversed, signed-index-overflow and gate/up windows use the original
+/// expert-tile kernel. Padded rank remains eight, including B's row stride.
+#[allow(clippy::too_many_arguments)]
+pub fn grids(
+    enabled: bool,
+    max_rank: u32,
+    k_in: u32,
+    n_out: u32,
+    n_experts: u32,
+    row_offset: u32,
+    row_end: u32,
+    x_gather: u32,
+) -> Option<([u32; 3], [u32; 3])> {
+    let window = row_end.checked_sub(row_offset)?;
+    (enabled
+        && max_rank == 8
+        && k_in == 1024
+        && n_out == 4096
+        && (1..=288).contains(&n_experts)
+        && (1..=64).contains(&window)
+        && row_end <= i32::MAX as u32
+        && x_gather == 0)
+        .then_some(([2, window, 1], [1024, window, 1]))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{grids, parse_requested};
+
+    fn shape(start: u32, end: u32) -> Option<([u32; 3], [u32; 3])> {
+        grids(true, 8, 1024, 4096, 288, start, end, 0)
+    }
+
+    #[test]
+    fn strict_opt_in() {
+        assert_eq!(parse_requested(None), Ok(false));
+        assert_eq!(parse_requested(Some("0")), Ok(false));
+        assert_eq!(parse_requested(Some("1")), Ok(true));
+        for invalid in ["", "true", "01", "2", " 1", "1\n"] {
+            assert!(parse_requested(Some(invalid)).is_err());
+        }
+    }
+
+    #[test]
+    fn exact_small_window_grids() {
+        for start in [0, 1, 63, 64, 137, 131008] {
+            for window in 1..=64 {
+                assert_eq!(
+                    shape(start, start + window),
+                    Some(([2, window, 1], [1024, window, 1]))
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn invalid_and_wide_windows_fall_back() {
+        for (start, end) in [
+            (0, 0),
+            (100, 100),
+            (100, 99),
+            (0, 65),
+            (31, 96),
+            (0, u32::MAX),
+        ] {
+            assert_eq!(shape(start, end), None);
+        }
+        assert!(shape(i32::MAX as u32 - 64, i32::MAX as u32).is_some());
+        assert_eq!(shape(i32::MAX as u32, i32::MAX as u32 + 1), None);
+    }
+
+    #[test]
+    fn unreviewed_shapes_and_gather_fall_back() {
+        assert_eq!(grids(false, 8, 1024, 4096, 288, 0, 8, 0), None);
+        for rank in [0, 1, 4, 7, 9, 16] {
+            assert_eq!(grids(true, rank, 1024, 4096, 288, 0, 8, 0), None);
+        }
+        for k in [0, 512, 2048, 4096, 8192] {
+            assert_eq!(grids(true, 8, k, 4096, 288, 0, 8, 0), None);
+        }
+        for hidden in [0, 1024, 4095, 4097] {
+            assert_eq!(grids(true, 8, 1024, hidden, 288, 0, 8, 0), None);
+        }
+        for experts in [0, 289, u32::MAX] {
+            assert_eq!(grids(true, 8, 1024, 4096, experts, 0, 8, 0), None);
+        }
+        for gather in [1, 2, u32::MAX] {
+            assert_eq!(grids(true, 8, 1024, 4096, 288, 0, 8, gather), None);
+        }
+        assert!(grids(true, 8, 1024, 4096, 1, 0, 8, 0).is_some());
+    }
+
+    #[test]
+    fn no_expert_axis_and_no_static_empty_tiles() {
+        // Exact launch counts, not a timing claim. The old 64-row window
+        // launches (2+1024)*288 CTAs, regardless of the actually routed rows.
+        for window in [8u32, 16, 32, 64] {
+            let (shrink, expand) = shape(31, 31 + window).unwrap();
+            let ctas = |grid: [u32; 3]| grid.iter().product::<u32>();
+            assert_eq!(ctas(shrink) + ctas(expand), 1026 * window);
+            assert!(ctas(shrink) + ctas(expand) < 1026 * 288);
+        }
+    }
+}
