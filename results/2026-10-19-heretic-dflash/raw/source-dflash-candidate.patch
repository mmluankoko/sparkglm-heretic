index 0000000..264e3f6
--- /dev/null
+++ b/crates/spark-model/src/layers/glm_lora.rs
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Request-scoped GLM rank-one attention delta, before the existing TP reduce.
+
+use anyhow::{Result, ensure};
+use spark_runtime::gpu::DevicePtr;
+
+use crate::layer::{ForwardContext, MoeLoraRoute};
+use crate::layers::ops::lora_delta::{LoraKernels, LoraPair, apply_lora_delta};
+
+fn active_path(route: MoeLoraRoute, graph: bool, seqs: usize, sp: bool) -> Result<bool> {
+    match route {
+        MoeLoraRoute::Skip => return Ok(false),
+        MoeLoraRoute::Refuse => anyhow::bail!("GLM LoRA requires one installed adapter per pass"),
+        MoeLoraRoute::Fold | MoeLoraRoute::FoldDflash => {}
+    }
+    ensure!(!graph, "GLM LoRA attention requires eager execution");
+    ensure!(
+        seqs <= 1,
+        "GLM LoRA attention does not support mixed/multi-sequence passes"
+    );
+    ensure!(
+        !sp,
+        "GLM LoRA attention does not support sequence-parallel prefill"
+    );
+    Ok(true)
+}
+
+/// Base requests return before checking the conservative adapter profile.
+pub(crate) fn active(ctx: &ForwardContext) -> Result<bool> {
+    active_path(
+        ctx.moe_lora_route,
+        ctx.graph_capture,
+        ctx.attn_metadata.map_or(1, |m| m.num_seqs as usize),
+        crate::layers::glm_sp::current().is_some(),
+    )
+}
+
+/// The route proves entry admission; metadata counts owners, not temporal rows.
+pub(crate) fn dflash_context(ctx: &ForwardContext, rows: usize) -> bool {
+    crate::lora::heretic_dflash::context_allowed(
+        matches!(ctx.moe_lora_route, MoeLoraRoute::FoldDflash),
+        ctx.graph_capture,
+        ctx.attn_metadata.map_or(0, |m| m.num_seqs as usize),
+        rows,
+        ctx.host_token_ids.map(<[u32]>::len),
+        crate::layers::glm_sp::current().is_some(),
+    )
+}
+
+pub(crate) fn reject_unsupported(installed: bool, ctx: &ForwardContext, path: &str) -> Result<()> {
+    if installed && active(ctx)? {
+        anyhow::bail!("GLM LoRA attention path is not implemented: {path}");
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn apply(
+    pair: &LoraPair,
+    kernels: &LoraKernels,
+    input: DevicePtr,
+    output: DevicePtr,
+    rows: u32,
+    k_in: u32,
+    n_out: u32,
+    ctx: &ForwardContext,
+    stream: u64,
+) -> Result<()> {
+    if !active(ctx)? {
+        return Ok(());
+    }
+    ensure!(rows > 0, "GLM LoRA attention received an empty projection");
+    ensure!(
+        pair.rank == 1 && pair.max_rank == 8,
+        "GLM LoRA attention requires rank 1 padded to 8"
+    );
+    ensure!(
+        pair.k_in == k_in && pair.n_out == n_out,
+        "GLM LoRA attention local projection shape mismatch"
+    );
+    ensure!(
+        ctx.buffers.lora_xa_bytes() >= rows as usize * pair.max_rank as usize * 2
+            && ctx.buffers.lora_delta_bytes() >= rows as usize * pair.n_out as usize * 2,
+        "GLM LoRA attention scratch is too small"
+    );
+    if matches!(ctx.moe_lora_route, MoeLoraRoute::FoldDflash) {
+        ensure!(
+            dflash_context(ctx, rows as usize),
+            "invalid Heretic DFlash delta context"
+        );
+        return crate::layers::ops::lora_pair_rows::apply(
+            ctx.gpu,
+            kernels,
+            pair,
+            input,
+            output,
+            rows,
+            ctx.buffers.lora_xa(),
+            stream,
+        );
+    }
+    apply_lora_delta(
+        ctx.gpu,
+        kernels,
+        pair,
+        input,
+        output,
+        rows,
+        ctx.buffers.lora_xa(),
+        ctx.buffers.lora_delta(),
+        stream,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn base_route_preserves_fast_paths() {
+        assert!(!active_path(MoeLoraRoute::Skip, true, 8, true).unwrap());
+    }
+
+    #[test]
+    fn adapter_route_rejects_unimplemented_execution_modes() {
+        assert!(active_path(MoeLoraRoute::Fold, false, 1, false).unwrap());
+        for (graph, seqs, sp) in [(true, 1, false), (false, 2, false), (false, 1, true)] {
+            assert!(active_path(MoeLoraRoute::Fold, graph, seqs, sp).is_err());
+        }
+        assert!(active_path(MoeLoraRoute::Refuse, false, 1, false).is_err());
+    }
+}
