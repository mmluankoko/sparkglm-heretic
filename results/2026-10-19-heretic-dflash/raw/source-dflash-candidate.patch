+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! GLM MLA external adapter: distinct from the model's intrinsic MLA ranks.
+
+use anyhow::Result;
+use spark_runtime::gpu::{DevicePtr, GpuBackend};
+
+use super::Qwen3AttentionLayer;
+use crate::layer::ForwardContext;
+use crate::layers::ops::lora_delta::{LoraKernels, LoraPair};
+
+impl Qwen3AttentionLayer {
+    #[allow(clippy::too_many_arguments)]
+    pub(in crate::layers::qwen3_attention) fn apply_glm_o_lora(
+        &self,
+        input: DevicePtr,
+        output: DevicePtr,
+        rows: u32,
+        local_input: u32,
+        hidden: u32,
+        ctx: &ForwardContext,
+        stream: u64,
+    ) -> Result<()> {
+        if ctx.config.model_type == "glm5_next"
+            && let Some(lw) = &self.lora
+            && let Some(pair) = &lw.o
+        {
+            crate::layers::glm_lora::apply(
+                pair,
+                &lw.kernels,
+                input,
+                output,
+                rows,
+                local_input,
+                hidden,
+                ctx,
+                stream,
+            )?;
+        }
+        Ok(())
+    }
+
+    pub(in crate::layers::qwen3_attention) fn reject_glm_lora_path(
+        &self,
+        ctx: &ForwardContext,
+        path: &str,
+    ) -> Result<()> {
+        crate::layers::glm_lora::reject_unsupported(
+            ctx.config.model_type == "glm5_next"
+                && self.lora.as_ref().is_some_and(|lw| lw.o.is_some()),
+            ctx,
+            path,
+        )
+    }
+
+    pub(crate) fn set_shared_lora_weights(
+        &mut self,
+        full: Option<LoraPair>,
+        split: Option<LoraPair>,
+        kernels: LoraKernels,
+        gpu: &dyn GpuBackend,
+    ) -> Result<()> {
+        if let crate::layers::FfnComponent::Moe(m) = &mut self.ffn {
+            return m.set_shared_lora_weights(full, split, kernels, gpu);
+        }
+        anyhow::bail!("GLM MLA shared LoRA requires a MoE FFN")
+    }
+}
diff --git a/crates/spark-model/src/lora/glm53.rs b/crates/spark-model/src/lora/glm53.rs
new file mode 100644
index 0000000..7bd1164
--- /dev/null
+++ b/crates/spark-model/src/lora/glm53.rs
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Deliberately bounded GLM-5.3 Heretic rank-one bundle importer.
+//! Original PEFT tensors are audited at global geometry, then A is sliced
+//! exactly like the base row-parallel projection. B remains replicated.
+
+use std::collections::BTreeMap;
+use std::sync::atomic::{AtomicU64, AtomicUsize};
+
+use anyhow::{Result, bail, ensure};
+use atlas_core::config::ModelConfig;
+use spark_runtime::gpu::{DevicePtr, GpuBackend};
+use spark_runtime::weights::WeightStore;
+
+use super::*;
+use crate::layers::ops::lora_delta::LoraPair;
+use crate::weight_map::DenseWeight;
+
+const STRIDE: usize = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Target {
+    Output(usize),
+    Shared(usize),
+    Expert(usize, u16),
+}
+
+impl Target {
+    fn layer(self) -> usize {
+        match self {
+            Self::Output(l) | Self::Shared(l) | Self::Expert(l, _) => l,
+        }
+    }
+
+    fn full_input(self) -> usize {
+        match self {
+            Self::Output(l) if l % 4 == 3 => 16384,
+            Self::Output(_) => 8192,
+            Self::Shared(_) | Self::Expert(_, _) => 2048,
+        }
+    }
+}
+
+fn classify(key: &str) -> Result<(Target, usize)> {
+    let (module, ab) = if let Some(m) = key.strip_suffix(".lora_A.weight") {
+        (m, 0)
+    } else if let Some(m) = key.strip_suffix(".lora_B.weight") {
+        (m, 1)
+    } else {
+        bail!("GLM Heretic: unrecognized tensor {key}");
+    };
+    ensure!(
+        module.starts_with("base_model.model."),
+        "not a PEFT key: {key}"
+    );
+    let (_, suffix) = module
+        .split_once(".layers.")
+        .ok_or_else(|| anyhow::anyhow!("not a layer key: {key}"))?;
+    let (index, tail) = suffix
+        .split_once('.')
+        .ok_or_else(|| anyhow::anyhow!("malformed layer key: {key}"))?;
+    let layer: usize = index.parse()?;
+    let target = match tail {
+        "self_attn.o_proj" if (15..=39).contains(&layer) => Target::Output(layer),
+        "mlp.shared_experts.down_proj" if (18..=40).contains(&layer) => Target::Shared(layer),
+        t if t.starts_with("mlp.experts.") && (25..=43).contains(&layer) => {
+            let (expert, projection) = t["mlp.experts.".len()..]
+                .split_once('.')
+                .ok_or_else(|| anyhow::anyhow!("malformed expert key: {key}"))?;
+            let expert: u16 = expert.parse()?;
+            ensure!(
+                expert < 288 && projection == "down_proj",
+                "unsupported expert target: {key}"
+            );
+            Target::Expert(layer, expert)
+        }
+        _ => bail!("unsupported GLM Heretic target: {key}"),
+    };
+    Ok((target, ab))
+}
+
+fn pair_bytes(input: usize) -> usize {
+    STRIDE * (input + 4096) * 2
+}
+
+fn pack(
+    store: &WeightStore,
+    names: &[Option<String>; 2],
+    full_input: usize,
+    column_start: usize,
+    input: usize,
+    gpu: &dyn GpuBackend,
+    pool: DevicePtr,
+    offset: &mut usize,
+) -> Result<LoraPair> {
+    let [Some(a), Some(b)] = names else {
+        bail!("incomplete GLM Heretic A/B pair");
+    };
+    let a = store.get(a)?;
+    let b = store.get(b)?;
+    ensure!(
+        a.shape == vec![1, full_input] && b.shape == vec![4096, 1],
+        "GLM Heretic unexpected A/B shapes {:?}/{:?}",
+        a.shape,
+        b.shape
+    );
+    let mut source = vec![0u8; full_input * 2];
+    gpu.copy_d2h(a.ptr, &mut source)?;
+    let a_ptr = pool.offset(*offset);
+    *offset += input * STRIDE * 2;
+    let b_ptr = pool.offset(*offset);
+    *offset += 4096 * STRIDE * 2;
+    gpu.copy_h2d(&source[column_start * 2..(column_start + input) * 2], a_ptr)?;
+    let mut source_b = vec![0u8; 4096 * 2];
+    gpu.copy_d2h(b.ptr, &mut source_b)?;
+    let mut padded_b = vec![0u8; 4096 * STRIDE * 2];
+    for row in 0..4096 {
+        padded_b[row * STRIDE * 2..row * STRIDE * 2 + 2]
+            .copy_from_slice(&source_b[row * 2..row * 2 + 2]);
+    }
+    gpu.copy_h2d(&padded_b, b_ptr)?;
+    Ok(LoraPair {
+        a: DenseWeight { weight: a_ptr },
+        b: DenseWeight { weight: b_ptr },
+        rank: 1,
+        k_in: input as u32,
+        n_out: 4096,
+        scale: 1.0,
+        max_rank: STRIDE as u32,
+    })
+}
+
+pub(super) fn load(
+    adapters: &[LoraAdapterInput<'_>],
+    cfg: &ModelConfig,
+    gpu: &dyn GpuBackend,
+    max_loras: usize,
+    max_rank: usize,
+) -> Result<LoraWeights> {
+    ensure!(
+        std::env::var("ATLAS_GLM_HERETIC").as_deref() == Ok("1"),
+        "GLM Heretic importer requires ATLAS_GLM_HERETIC=1"
+    );
+    ensure!(
+        adapters.len() == 1 && max_loras == 1 && max_rank == STRIDE,
+        "GLM Heretic requires one resident adapter and --max-loras=1 --max-lora-rank=8"
+    );
+    ensure!(
+        cfg.hidden_size == 4096
+            && cfg.num_hidden_layers == 45
+            && cfg.num_experts == 288
+            && cfg.tp_world_size == 2
+            && cfg.ep_world_size == 2
+            && cfg.expert_tp,
+        "GLM Heretic requires audited GLM53 TP2/expert-TP2 geometry"
+    );
+    ensure!(
+        cfg.num_attention_heads * cfg.v_head_dim == 8192
+            && cfg.linear_num_key_heads * cfg.linear_key_head_dim == 4096
+            && cfg.routed_inter_local() == 1024
+            && cfg.shared_expert_intermediate_size == 2048,
+        "GLM Heretic local MLA/KDA/expert geometry differs from the audited model"
+    );
+    let adapter = &adapters[0];
+    let peft = &adapter.peft;
+    ensure!(
+        adapter.name == "heretic" && peft.r == 1 && peft.scaling() == 1.0 && !peft.use_rslora,
+        "only the fixed heretic r1 alpha1 bundle is supported"
+    );
+    let mut targets: BTreeMap<Target, [Option<String>; 2]> = BTreeMap::new();
+    for name in adapter.store.names() {
+        let (target, ab) = classify(name)?;
+        let cell = &mut targets.entry(target).or_default()[ab];
+        ensure!(cell.is_none(), "duplicate GLM Heretic target {name}");
+        *cell = Some(name.to_string());
+    }
+    let count = |kind: u8| {
+        targets
+            .keys()
+            .filter(|t| {
+                matches!(
+                    (kind, t),
+                    (0, Target::Output(_)) | (1, Target::Shared(_)) | (2, Target::Expert(_, _))
+                )
+            })
+            .count()
+    };
+    ensure!(
+        (count(0), count(1), count(2)) == (25, 23, 5472),
+        "incomplete GLM Heretic bundle: expected 25 output + 23 shared + 5472 expert pairs"
+    );
+    // Full shared and split shared must both exist: prefill may dynamically
+    // select replicated or intermediate-sharded shared work.
+    let pool_bytes: usize = targets
+        .keys()
+        .map(|t| match t {
+            Target::Shared(_) => pair_bytes(2048) + pair_bytes(1024),
+            _ => pair_bytes(t.full_input() / 2),
+        })
+        .sum();
+    ensure!(
+        pool_bytes * 2 < gpu.free_memory()?,
+        "insufficient memory for GLM Heretic pool"
+    );
+    let pool = gpu.alloc(pool_bytes)?;
+    gpu.memset(pool, 0, pool_bytes)?;
+    let mut layers: Vec<Option<LoraLayerWeights>> = vec![None; cfg.num_hidden_layers];
+    let mut offset = 0;
+    for (target, names) in &targets {
+        let full = target.full_input();
+        let layer =
+            layers[target.layer()].get_or_insert_with(|| LoraLayerWeights::empty(target.layer()));
+        match target {
+            Target::Shared(_) => {
+                layer.shared_down = Some(pack(
+                    adapter.store,
+                    names,
+                    full,
+                    0,
+                    full,
+                    gpu,
+                    pool,
+                    &mut offset,
+                )?);
+                layer.shared_down_split = Some(pack(
+                    adapter.store,
+                    names,
+                    full,
+                    cfg.ep_rank * (full / 2),
+                    full / 2,
+                    gpu,
+                    pool,
+                    &mut offset,
+                )?);
+            }
+            Target::Output(_) => {
+                layer.o_proj = Some(pack(
+                    adapter.store,
+                    names,
+                    full,
+                    cfg.tp_rank * (full / 2),
+                    full / 2,
+                    gpu,
+                    pool,
+                    &mut offset,
+                )?);
+            }
+            Target::Expert(_, expert) => {
+                let pair = pack(
+                    adapter.store,
+                    names,
+                    full,
+                    cfg.ep_rank * (full / 2),
+                    full / 2,
+                    gpu,
+                    pool,
+                    &mut offset,
+                )?;
+                layer
+                    .experts
+                    .get_or_insert_with(ExpertLoraLayer::default)
+                    .pairs
+                    .insert((*expert, ExpertProj::Down), pair);
+            }
+        }
+    }
+    ensure!(offset == pool_bytes, "GLM Heretic pool layout mismatch");
+    let scale_table = gpu.alloc(4)?;
+    gpu.copy_h2d(&1.0f32.to_le_bytes(), scale_table)?;
+    tracing::info!(
+        "GLM Heretic: 5520 pairs audited and TP sliced, pool={} bytes, rank={} expert_rank={}",
+        pool_bytes,
+        cfg.tp_rank,
+        cfg.ep_rank
+    );
+    Ok(LoraWeights {
+        name: adapter.name.clone(),
+        adapter_config: peft.clone(),
+        max_rank: STRIDE,
+        max_loras: 1,
+        pool,
+        pool_bytes,
+        expert_pool: None,
+        expert_pool_bytes: 0,
+        slots: vec![AdapterSlot {
+            name: adapter.name.clone(),
+            adapter_config: peft.clone(),
+            layers,
+            generation: 0,
+        }],
+        active: 0,
+        tables: BTreeMap::new(),
+        scale_table,
+        ref_counts: vec![AtomicUsize::new(0)],
+        pinned: 1,
+        last_used: vec![AtomicU64::new(0)],
+        lru_tick: AtomicU64::new(0),
+        overlay_raw: vec![None],
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fixed_bundle_targets_reject_padding_and_unsupported_layers() {
+        assert_eq!(classify("base_model.model.model.language_model.layers.25.mlp.experts.287.down_proj.lora_A.weight").unwrap(), (Target::Expert(25, 287), 0));
+        assert!(classify("base_model.model.model.language_model.layers.25.mlp.experts.287.gate_proj.lora_A.weight").is_err());
+        assert!(
+            classify(
+                "base_model.model.model.language_model.layers.44.self_attn.o_proj.lora_B.weight"
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn output_geometry_distinguishes_mla_from_kda() {
+        assert_eq!(Target::Output(15).full_input(), 16384);
+        assert_eq!(Target::Output(16).full_input(), 8192);
+        assert_eq!(pair_bytes(1024), 81920);
+    }
+}
diff --git a/crates/spark-model/src/lora/heretic_dflash.rs b/crates/spark-model/src/lora/heretic_dflash.rs
new file mode 100644
index 0000000..2380a94
--- /dev/null
+++ b/crates/spark-model/src/lora/heretic_dflash.rs
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Pure admission for one immutable Heretic owner on the eager DFlash lane.
+
+pub fn parse_requested(value: Option<&str>) -> Result<bool, &'static str> {
+    match value {
+        None | Some("0") => Ok(false),
+        Some("1") => Ok(true),
+        _ => Err("ATLAS_GLM_HERETIC_DFLASH must be 0 or 1"),
+    }
+}
+
+/// This capability never authorizes the fixed-width, fused or multi-owner
+/// verifiers. The actual Kgamma entry also checks the installed model profile.
+pub fn request_allowed(
+    enabled: bool,
+    profile: bool,
+    slot: i32,
+    id: u64,
+    installed_id: u64,
+    rows: usize,
+) -> bool {
+    enabled && profile && slot == 0 && id != 0 && id == installed_id && (1..=8).contains(&rows)
+}
+
+/// A temporal block has one owner and K host tokens. The scoped route is
+/// created only after request admission; a normal Fold is not this proof.
+pub fn context_allowed(
+    scoped: bool,
+    graph: bool,
+    owners: usize,
+    rows: usize,
+    host_rows: Option<usize>,
+    sp: bool,
+) -> bool {
+    scoped && !graph && owners == 1 && (1..=8).contains(&rows) && host_rows == Some(rows) && !sp
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn capability_is_strict_and_off_until_requested() {
+        assert_eq!(parse_requested(None), Ok(false));
+        assert_eq!(parse_requested(Some("0")), Ok(false));
+        assert_eq!(parse_requested(Some("1")), Ok(true));
+        for value in ["", "true", "01", "2", " 1", "1\n"] {
+            assert!(parse_requested(Some(value)).is_err());
+        }
+    }
+
+    #[test]
+    fn only_the_installed_owner_and_temporal_width_are_admitted() {
+        let id = 0xA693_4701_9123_002D;
+        for rows in 1..=8 {
+            assert!(request_allowed(true, true, 0, id, id, rows));
+            assert!(!request_allowed(false, true, 0, id, id, rows));
+            assert!(!request_allowed(true, false, 0, id, id, rows));
+        }
+        for rows in [0, 9, 32, usize::MAX] {
+            assert!(!request_allowed(true, true, 0, id, id, rows));
+        }
+        for (slot, requested, installed) in [
+            (-2, 0, id),
+            (-1, id, id),
+            (1, id, id),
+            (0, 0, id),
+            (0, id, 0),
+            (0, id, id ^ (1u64 << 63)),
+        ] {
+            assert!(!request_allowed(true, true, slot, requested, installed, 8));
+        }
+    }
+
+    #[test]
+    fn temporal_context_cannot_be_confused_with_multiple_owners() {
+        for rows in 1..=8 {
+            assert!(context_allowed(true, false, 1, rows, Some(rows), false));
+            assert!(!context_allowed(false, false, 1, rows, Some(rows), false));
+            assert!(!context_allowed(true, true, 1, rows, Some(rows), false));
+            assert!(!context_allowed(true, false, 1, rows, Some(rows), true));
+            assert!(!context_allowed(true, false, 1, rows, None, false));
+            assert!(!context_allowed(
+                true,
+                false,
+                1,
+                rows,
+                Some(rows + 1),
+                false
+            ));
+            for owners in [0, 2, 4, 8] {
+                assert!(!context_allowed(
+                    true,
+                    false,
+                    owners,
+                    rows,
+                    Some(rows),
+                    false
+                ));
+            }
+        }
+        for rows in [0, 9, 32] {
+            assert!(!context_allowed(true, false, 1, rows, Some(rows), false));
+        }
+    }
+}
diff --git a/crates/spark-model/src/lora/request_identity.rs b/crates/spark-model/src/lora/request_identity.rs
new file mode 100644
index 0000000..b638b8a
--- /dev/null
+++ b/crates/spark-model/src/lora/request_identity.rs
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Request identity shared by HTTP routing, CUDA slot maps and the TP wire.
+
+/// Explicit unadapted base; distinct from the legacy `-1 = active` request.
+pub const BASE_SLOT: i32 = -2;
+pub const DEFAULT_SLOT: i32 = -1;
+pub const EP_CMD_ADAPTER_IDENTITY: u32 = 0xFFFF_FFE2;
+
+/// Resident adapters can use speculative target verification only on an
+/// explicitly unadapted request. A legacy default may resolve to an adapter.
+pub fn disable_speculation(resident_adapters: bool, slot: i32) -> bool {
+    resident_adapters && slot != BASE_SLOT
+}
+
+/// Only an explicit base selector together with the base cache identity is
+/// eligible for a graph that omits all resident adapter work.
+pub fn explicit_base(slot: i32, id: u64) -> bool {
+    slot == BASE_SLOT && id == 0
+}
+
+pub fn parse_base_fast(value: Option<&str>) -> Result<bool, &'static str> {
+    match value {
+        None | Some("0") => Ok(false),
+        Some("1") => Ok(true),
+        _ => Err("ATLAS_GLM_HERETIC_BASE_FAST must be 0 or 1"),
+    }
+}
+
+/// Preserve other models' existing graph policy. GLM with a resident adapter
+/// can record/replay only the admitted, explicitly enabled base variant.
+pub fn single_request_graph_eager(
+    glm_resident_adapter: bool,
+    base_fast: bool,
+    launch_admitted: bool,
+    slot: i32,
+    id: u64,
+    legacy_eager: bool,
+) -> bool {
+    if glm_resident_adapter {
+        !(base_fast && launch_admitted && explicit_base(slot, id))
+    } else {
+        legacy_eager
+    }
+}
+
+/// Target verification is still unavailable for Heretic, including eager
+/// verification. No earlier decode route is part of this decision.
+pub fn single_request_verify_allowed(glm_resident_adapter: bool, slot: i32, id: u64) -> bool {
+    !glm_resident_adapter || explicit_base(slot, id)
+}
+
+/// Resolve a host request selector to a device slot (`-1` means no delta).
+pub fn resolve_request_slot(slot: i32, active: i32) -> i32 {
+    match slot {
+        BASE_SLOT => -1,
+        DEFAULT_SLOT => active,
+        slot => slot,
+    }
+}
+
+/// Fixed-width wire representation; full u64 cache identity is preserved.
+pub fn encode_identity(slot: i32, id: u64) -> Result<[u32; 3], &'static str> {
+    if !((slot == BASE_SLOT && id == 0) || (slot >= 0 && id != 0)) {
+        return Err("adapter identity must be explicit base/id0 or a resolved slot/nonzero id");
+    }
+    Ok([slot as u32, id as u32, (id >> 32) as u32])
+}
+
+pub fn decode_identity(words: [u32; 3]) -> Result<(i32, u64), &'static str> {
+    let slot = words[0] as i32;
+    let id = words[1] as u64 | ((words[2] as u64) << 32);
+    encode_identity(slot, id)?;
+    Ok((slot, id))
+}
+
+/// Repeating a route for a later chunk is safe; changing computed KV/SSM's
+/// identity is not. Fresh sequence slots can be reused by the other model.
+pub fn validate_identity_update(
+    current_slot: i32,
+    current_id: u64,
+    computed_tokens: usize,
+    next_slot: i32,
+    next_id: u64,
+) -> Result<(), &'static str> {
+    encode_identity(next_slot, next_id)?;
+    if computed_tokens > 0 && (current_slot != next_slot || current_id != next_id) {
+        return Err("TP adapter identity changed after prefill began");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn base_never_resolves_to_installed_adapter() {
+        for active in [0, 1, 7] {
+            assert_eq!(resolve_request_slot(BASE_SLOT, active), -1);
+            assert_eq!(resolve_request_slot(DEFAULT_SLOT, active), active);
+            assert_eq!(resolve_request_slot(3, active), 3);
+        }
+    }
+
+    #[test]
+    fn identity_roundtrip_preserves_high_bits_and_base() {
+        for (slot, id) in [(BASE_SLOT, 0), (0, 0xFEDC_BA98_7654_3210), (1, u64::MAX)] {
+            assert_eq!(
+                decode_identity(encode_identity(slot, id).unwrap()),
+                Ok((slot, id))
+            );
+        }
+    }
+
+    #[test]
+    fn unresolved_or_inconsistent_identity_is_rejected() {
+        for (slot, id) in [(-1, 123), (BASE_SLOT, 123), (0, 0), (-3, 0)] {
+            assert!(encode_identity(slot, id).is_err());
+            assert!(decode_identity([slot as u32, id as u32, 0]).is_err());
+        }
+    }
+
+    #[test]
+    fn chunks_keep_identity_and_freed_slots_can_switch_models() {
+        let heretic = 0x1234_5678_ABCD_EF01;
+        assert!(validate_identity_update(BASE_SLOT, 0, 0, 0, heretic).is_ok());
+        assert!(validate_identity_update(0, heretic, 0, BASE_SLOT, 0).is_ok());
+        assert!(validate_identity_update(0, heretic, 512, 0, heretic).is_ok());
+        assert!(validate_identity_update(BASE_SLOT, 0, 512, BASE_SLOT, 0).is_ok());
+        assert!(validate_identity_update(0, heretic, 512, BASE_SLOT, 0).is_err());
+        assert!(validate_identity_update(BASE_SLOT, 0, 512, 0, heretic).is_err());
+        assert!(validate_identity_update(0, heretic, 512, 0, heretic + 1).is_err());
+    }
+}
diff --git a/crates/spark-model/src/model/adapter_transport.rs b/crates/spark-model/src/model/adapter_transport.rs
new file mode 100644
index 0000000..9955fc6
--- /dev/null
+++ b/crates/spark-model/src/model/adapter_transport.rs
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Worker counterpart of the request adapter identity command (TP and EP).
+
+use anyhow::{Result, ensure};
+
+use super::types::TransformerModel;
+use crate::traits::SequenceState;
+
+impl TransformerModel {
+    pub(super) fn ep_worker_adapter_identity(&self, seq: &mut SequenceState) -> Result<()> {
+        let words = [
+            self.ep_broadcast_u32(0)?,
+            self.ep_broadcast_u32(0)?,
+            self.ep_broadcast_u32(0)?,
+        ];
+        let (slot, id) = crate::lora::decode_identity(words).map_err(anyhow::Error::msg)?;
+        ensure!(
+            self.adapter_id_for_slot(slot) == id,
+            "TP adapter identity mismatch: slot={slot}, head={id}, worker={}",
+            self.adapter_id_for_slot(slot),
+        );
+        // Repeated chunk/resume commands may restate the same route. Changing
+        // one after KV/SSM exists would reinterpret already-computed state.
+        crate::lora::validate_identity_update(
+            seq.adapter_slot,
+            seq.adapter_id,
+            seq.seq_len,
+            slot,
+            id,
+        )
+        .map_err(anyhow::Error::msg)?;
+        if seq.acquired_adapter_slot >= 0 && seq.acquired_adapter_slot != slot {
+            self.release_adapter_slot(seq.acquired_adapter_slot);
+            seq.acquired_adapter_slot = -1;
+        }
+        if slot >= 0 && seq.acquired_adapter_slot < 0 {
+            let acquired = self.acquire_adapter_slot(slot);
+            ensure!(acquired == slot, "TP adapter slot {slot} is not resident");
+            seq.acquired_adapter_slot = acquired;
+        }
+        seq.adapter_slot = slot;
+        seq.adapter_id = id;
+        if seq.seq_len == 0 {
+            tracing::info!(
+                rank = self.config.tp_rank,
+                sequence = seq.slot_idx,
+                adapter_slot = slot,
+                adapter_id = id,
+                "TP adapter identity received and validated"
+            );
+        }
+        Ok(())
+    }
+}
diff --git a/crates/spark-model/src/model/glm_heretic_dflash.rs b/crates/spark-model/src/model/glm_heretic_dflash.rs
new file mode 100644
index 0000000..951d953
--- /dev/null
+++ b/crates/spark-model/src/model/glm_heretic_dflash.rs
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Opt-in single-owner DFlash admission, independent of graph authorization.
+
+use std::sync::OnceLock;
+
+use anyhow::{Result, anyhow, ensure};
+
+use super::TransformerModel;
+use crate::traits::SequenceState;
+
+pub fn requested() -> Result<bool> {
+    static REQUESTED: OnceLock<Result<bool, String>> = OnceLock::new();
+    REQUESTED
+        .get_or_init(|| match std::env::var("ATLAS_GLM_HERETIC_DFLASH") {
+            Ok(value) => {
+                crate::lora::heretic_dflash::parse_requested(Some(&value)).map_err(str::to_owned)
+            }
+            Err(std::env::VarError::NotPresent) => Ok(false),
+            Err(error) => Err(error.to_string()),
+        })
+        .as_ref()
+        .copied()
+        .map_err(|error| anyhow!(error.clone()))
+}
+
+impl TransformerModel {
+    pub(in crate::model) fn log_glm_dflash_target(
+        &self,
+        seq: &SequenceState,
+        rows: usize,
+        heretic: bool,
+    ) -> Result<()> {
+        if requested()? {
+            tracing::debug!(
+                target: "spark_model::model::trait_impl::verify_d",
+                adapter_slot = seq.adapter_slot,
+                adapter_id = seq.adapter_id,
+                rows,
+                position = seq.seq_len,
+                heretic,
+                "GLM DFlash target"
+            );
+        }
+        Ok(())
+    }
+
+    pub(in crate::model) fn glm_heretic_dflash_owner(
+        &self,
+        seq: &SequenceState,
+        rows: usize,
+    ) -> Result<bool> {
+        Ok(crate::lora::heretic_dflash::request_allowed(
+            requested()?,
+            self.glm_fixed_adapter_profile(),
+            seq.adapter_slot,
+            seq.adapter_id,
+            self.adapter_id_for_slot(0),
+            rows,
+        ))
+    }
+
+    /// Only Kgamma (and the canonical one-row call through it) uses this.
+    /// Other verification entries retain the explicit-base-only admission.
+    pub(in crate::model) fn prepare_glm_dflash_verify(
+        &self,
+        seq: &SequenceState,
+        rows: usize,
+    ) -> Result<bool> {
+        let heretic = self.glm_heretic_dflash_owner(seq, rows)?;
+        if !heretic {
+            self.prepare_glm_single_verify(seq)?;
+            return Ok(false);
+        }
+        ensure!(
+            self.decode_is_canonical_verify()
+                && !self.config.dflash_capture_layers.is_empty()
+                && self.kv_cache.lock().config().cache_blocks_per_seq.is_none()
+                && !self.prefix_cache.is_active()
+                && crate::layers::glm_sp::current().is_none(),
+            "Heretic DFlash requires canonical paged verification, capture and eager single-owner state"
+        );
+        for (index, state) in seq.layer_states.iter().enumerate() {
+            if self.config.layer_type(index) == atlas_core::config::LayerType::LinearAttention {
+                let ssm = state
+                    .as_any()
+                    .downcast_ref::<crate::layer::SsmLayerState>()
+                    .ok_or_else(|| {
+                        anyhow!("Heretic DFlash KDA state type mismatch at layer {index}")
+                    })?;
+                ensure!(
+                    !ssm.h_is_f16
+                        && !ssm.kda_records.is_null()
+                        && ssm.conv_state_intermediates.len() >= rows,
+                    "Heretic DFlash requires FP32 records and K convolution snapshots at layer {index}"
+                );
+            }
+        }
+        self.prepare_glm_single_decode(seq)?;
+        Ok(true)
+    }
+}
diff --git a/crates/spark-model/src/model/glm_heretic_execution.rs b/crates/spark-model/src/model/glm_heretic_execution.rs
new file mode 100644
index 0000000..47eb710
--- /dev/null
+++ b/crates/spark-model/src/model/glm_heretic_execution.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Request boundary for the fixed GLM base/Heretic pair. Graph caches remain
+//! base-only; adapters never look up, record or replay those graph variants.
+
+use std::sync::OnceLock;
+
+use anyhow::{Result, anyhow, ensure};
+
+use super::TransformerModel;
+use crate::traits::SequenceState;
+
+/// Shared parser for startup admission, rank agreement and request execution.
+/// The capability is frozen before serving; there is no per-token env read.
+pub fn base_fast_requested() -> Result<bool> {
+    static REQUESTED: OnceLock<Result<bool, String>> = OnceLock::new();
+    REQUESTED
+        .get_or_init(|| match std::env::var("ATLAS_GLM_HERETIC_BASE_FAST") {
+            Ok(value) => crate::lora::parse_base_fast(Some(&value)).map_err(str::to_owned),
+            Err(std::env::VarError::NotPresent) => Ok(false),
+            Err(error) => Err(format!("ATLAS_GLM_HERETIC_BASE_FAST: {error}")),
+        })
+        .as_ref()
+        .copied()
+        .map_err(|error| anyhow!(error.clone()))
+}
+
+impl TransformerModel {
+    fn glm_resident_adapter(&self) -> bool {
+        self.config.model_type == "glm5_next" && self.lora.is_some()
+    }
+
+    /// Check the loaded owners as well as the server's stricter DualLaunch
+    /// admission. No graph is authorized by an environment switch alone.
+    pub(in crate::model) fn glm_fixed_adapter_profile(&self) -> bool {
+        let c = &self.config;
+        c.model_type == "glm5_next"
+            && c.hidden_size == 4096
+            && c.num_hidden_layers == 45
+            && c.num_experts == 288
+            && c.tp_world_size == 2
+            && c.ep_world_size == 2
+            && c.expert_tp
+            && c.adapter_max_rank == 8
+            && self.levers.max_decode_seqs == 1
+            && self.multi_rank_protocol_active()
+            && self.ep_protocol_v2
+            && !self.lora_rotatable
+            && self.overlays.is_none()
+            && self.lora.as_ref().is_some_and(|weights| {
+                weights.name == "heretic"
+                    && weights.active == 0
+                    && weights.adapter_config.r == 1
+                    && weights.max_rank == 8
+                    && weights.max_loras == 1
+                    && weights.slots.len() == 1
+            })
+    }
+
+    pub(in crate::model) fn single_request_graph_eager(&self, seq: &SequenceState) -> Result<bool> {
+        let legacy_eager = self.lora.is_some() && self.levers.lora_eager;
+        if !self.glm_resident_adapter() {
+            return Ok(legacy_eager);
+        }
+        Ok(crate::lora::single_request_graph_eager(
+            true,
+            base_fast_requested()?,
+            self.glm_fixed_adapter_profile(),
+            seq.adapter_slot,
+            seq.adapter_id,
+            legacy_eager,
+        ))
+    }
+
+    pub(in crate::model) fn glm_request_can_verify(&self, seq: &SequenceState) -> bool {
+        crate::lora::single_request_verify_allowed(
+            self.glm_resident_adapter(),
+            seq.adapter_slot,
+            seq.adapter_id,
+        )
+    }
+
+    /// Run at the actual compute entry, including worker/direct dispatches.
+    /// Metadata uploads and captured host branches must use this request's
+    /// identity, even when another model occupied the same sequence slot.
+    pub(in crate::model) fn prepare_glm_single_decode(&self, seq: &SequenceState) -> Result<()> {
+        if !self.glm_resident_adapter() {
+            return Ok(());
+        }
+        crate::lora::encode_identity(seq.adapter_slot, seq.adapter_id)
+            .map_err(anyhow::Error::msg)?;
+        ensure!(
+            self.adapter_id_for_slot(seq.adapter_slot) == seq.adapter_id,
+            "GLM request adapter identity does not match the installed owner"
+        );
+        self.stamp_overlay_route(seq.adapter_slot);
+        self.stamp_decode_moe_single(seq.adapter_slot);
+        Ok(())
+    }
+
+    pub(in crate::model) fn prepare_glm_single_verify(&self, seq: &SequenceState) -> Result<()> {
+        ensure!(
+            self.glm_request_can_verify(seq),
+            "GLM Heretic target verification is unsupported; only explicit base/id0 may verify"
+        );
+        self.prepare_glm_single_decode(seq)
+    }
+}
diff --git a/crates/spark-model/src/model/impl_lora_install.rs b/crates/spark-model/src/model/impl_lora_install.rs
new file mode 100644
index 0000000..8f7fe67
--- /dev/null
+++ b/crates/spark-model/src/model/impl_lora_install.rs
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Startup and rotation share this per-layer adapter installation walk.
+
+use anyhow::Result;
+
+use super::types::TransformerModel;
+use crate::layers::ops;
+
+impl TransformerModel {
+    /// Install one slot's per-layer pairs onto the layer structs (the shared
+    /// walk used by both initial install and runtime rotation). `layers` is
+    /// GLOBAL-layer-indexed. Returns the number of layers installed.
+    pub(super) fn install_lora_layers(
+        &mut self,
+        layers: &[Option<crate::lora::LoraLayerWeights>],
+        kernels: ops::lora_delta::LoraKernels,
+        tables: &std::collections::BTreeMap<
+            (usize, crate::lora::LoraModule),
+            (spark_runtime::gpu::DevicePtr, spark_runtime::gpu::DevicePtr),
+        >,
+        scale_table: spark_runtime::gpu::DevicePtr,
+    ) -> Result<usize> {
+        use crate::lora::LoraModule;
+        // Build the per-module routing table from the frozen pool tables + the
+        // active-slot pair dims (k_in/n_out/max_rank identical across slots, so
+        // the active pair supplies them). `None` when the module has no table
+        // (base-only) — the bgmv apply site then no-ops for that module.
+        let mk_route = |layer_idx: usize,
+                        module: LoraModule,
+                        pair: &Option<ops::lora_delta::LoraPair>|
+         -> Option<ops::lora_delta::LoraRoute> {
+            let p = pair.as_ref()?;
+            let (a_table, b_table) = *tables.get(&(layer_idx, module))?;
+            Some(ops::lora_delta::LoraRoute {
+                a_table,
+                b_table,
+                scale_table,
+                k_in: p.k_in,
+                n_out: p.n_out,
+                max_rank: p.max_rank,
+            })
+        };
+        let mut installed = 0usize;
+        for (idx, layer) in self.layers.iter_mut().enumerate() {
+            let Some(layer_weights) = layers.get(idx).and_then(|o| o.as_ref()) else {
+                continue;
+            };
+            let has_moe = layer_weights.router.is_some()
+                || layer_weights
+                    .experts
+                    .as_ref()
+                    .is_some_and(|e| !e.is_empty());
+            let has_attn_ffn = layer_weights.q_proj.is_some()
+                || layer_weights.k_proj.is_some()
+                || layer_weights.v_proj.is_some()
+                || layer_weights.o_proj.is_some()
+                || layer_weights.gate_proj.is_some()
+                || layer_weights.up_proj.is_some()
+                || layer_weights.down_proj.is_some();
+            let has_shared =
+                layer_weights.shared_down.is_some() || layer_weights.shared_down_split.is_some();
+            let any = layer
+                .as_any_mut()
+                .ok_or_else(|| anyhow::anyhow!("LoRA: adapted layer {idx} is not downcastable"))?;
+            // Full-attention layer: attention + dense-FFN + MoE. Linear-attention
+            // (GDN/SSM) layer: MoE ONLY — its attention projections are rejected at
+            // classify, but its MoE FFN exists on every layer, so a real all-layer
+            // MoE adapter routes its router/expert deltas here too.
+            if let Some(attn) = any.downcast_mut::<crate::layers::Qwen3AttentionLayer>() {
+                if self.config.model_type == "glm5_next"
+                    && let Some(pair) = layer_weights.o_proj
+                {
+                    anyhow::ensure!(
+                        pair.k_in as usize
+                            == self.config.num_attention_heads * self.config.v_head_dim
+                            && pair.n_out as usize == self.config.hidden_size,
+                        "GLM MLA LoRA O projection does not match this TP shard"
+                    );
+                }
+                let attn_weights = ops::lora_delta::LoraAttnWeights {
+                    // #30: the global layer index (from `self.layers.enumerate()`) —
+                    // the key the request slot's GLOBAL-layer-indexed pairs use.
+                    layer_idx: idx,
+                    q: layer_weights.q_proj,
+                    k: layer_weights.k_proj,
+                    v: layer_weights.v_proj,
+                    o: layer_weights.o_proj,
+                    kernels,
+                    q_route: mk_route(idx, LoraModule::QProj, &layer_weights.q_proj),
+                    k_route: mk_route(idx, LoraModule::KProj, &layer_weights.k_proj),
+                    v_route: mk_route(idx, LoraModule::VProj, &layer_weights.v_proj),
+                    o_route: mk_route(idx, LoraModule::OProj, &layer_weights.o_proj),
+                };
+                let ffn_weights = if layer_weights.gate_proj.is_some()
+                    || layer_weights.up_proj.is_some()
+                    || layer_weights.down_proj.is_some()
+                {
+                    Some(ops::lora_delta::LoraFfnWeights {
+                        gate: layer_weights.gate_proj,
+                        up: layer_weights.up_proj,
+                        down: layer_weights.down_proj,
+                        kernels,
+                    })
+                } else {
+                    None
+                };
+                attn.set_lora_weights(attn_weights, ffn_weights)?;
+                if has_moe {
+                    attn.set_moe_lora_weights(
+                        layer_weights.router,
+                        layer_weights.experts.clone().unwrap_or_default(),
+                        kernels,
+                        self.gpu.as_ref(),
+                    )?;
+                }
+                if has_shared {
+                    attn.set_shared_lora_weights(
+                        layer_weights.shared_down,
+                        layer_weights.shared_down_split,
+                        kernels,
+                        self.gpu.as_ref(),
+                    )?;
+                }
+            } else if let Some(kda) = any.downcast_mut::<crate::layers::Glm5KdaLayer>() {
+                anyhow::ensure!(
+                    layer_weights.q_proj.is_none()
+                        && layer_weights.k_proj.is_none()
+                        && layer_weights.v_proj.is_none()
+                        && layer_weights.gate_proj.is_none()
+                        && layer_weights.up_proj.is_none()
+                        && layer_weights.down_proj.is_none(),
+                    "GLM KDA adapter supports only attention O and MoE down projections"
+                );
+                kda.set_lora_weights(layer_weights.o_proj, kernels)?;
+                if has_moe {
+                    kda.set_moe_lora_weights(
+                        layer_weights.router,
+                        layer_weights.experts.clone().unwrap_or_default(),
+                        kernels,
+                        self.gpu.as_ref(),
+                    )?;
+                }
+                if has_shared {
+                    kda.set_shared_lora_weights(
+                        layer_weights.shared_down,
+                        layer_weights.shared_down_split,
+                        kernels,
+                        self.gpu.as_ref(),
+                    )?;
+                }
+            } else if let Some(ssm) = any.downcast_mut::<crate::layers::Qwen3SsmLayer>() {
+                anyhow::ensure!(!has_shared, "shared-expert LoRA is currently GLM-only");
+                if has_attn_ffn {
+                    anyhow::bail!(
+                        "LoRA: attention/dense-FFN delta on linear-attention layer {idx} — \
+                         classify should have rejected this (only MoE router/experts are \
+                         valid on GDN layers)"
+                    );
+                }
+                if has_moe {
+                    ssm.set_moe_lora_weights(
+                        layer_weights.router,
+                        layer_weights.experts.clone().unwrap_or_default(),
+                        kernels,
+                        self.gpu.as_ref(),
+                    )?;
+                }
+            } else {
+                anyhow::bail!(
+                    "LoRA: adapted layer {idx} is neither a Qwen3AttentionLayer, \
+                     Qwen3SsmLayer nor Glm5KdaLayer (loader/adapter layer-type mismatch)"
+                );
+            }
+            installed += 1;
+        }
+        Ok(installed)
+    }
+}
diff --git a/crates/spark-server/src/api/chat/handler.rs b/crates/spark-server/src/api/chat/handler.rs
new file mode 100644
index 0000000..fda04ba
--- /dev/null
+++ b/crates/spark-server/src/api/chat/handler.rs
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! OpenAI chat HTTP edge: body parsing, model loading and wire encoding.
+
+use axum::http::StatusCode;
+use axum::response::Response;
+
+use super::{ChatOutcome, ResponseEcho, chat_completions_inner};
+use crate::api::compact::openai_error_response;
+
+pub async fn chat_completions(
+    // The HOST, not `CurrentModel`: this is the one handler that can CREATE the
+    // model. Extractors run before the body is read, so `CurrentModel` would
+    // hand back whatever was loaded BEFORE the request said which model it
+    // wanted — exactly the thing the auto-swap has to decide on.
+    axum::extract::State(host): axum::extract::State<
+        std::sync::Arc<crate::main_modules::model_host::ModelHost>,
+    >,
+    req_ctx: Option<axum::extract::Extension<crate::rate_limiter::RequestContext>>,
+    body: axum::body::Bytes,
+) -> Response {
+    // Parse the body ourselves (instead of using axum's `Json`
+    // extractor) so the same bytes can feed both the deserialized
+    // handler path and the `--dump` raw-capture path without
+    // cloning the struct or cascading `Serialize` through every
+    // request type.
+    let req: crate::openai::ChatCompletionRequest = match serde_json::from_slice(&body) {
+        Ok(r) => r,
+        Err(e) => {
+            return openai_error_response(
+                StatusCode::BAD_REQUEST,
+                format!("Invalid request JSON: {e}"),
+            );
+        }
+    };
+
+    // Unknown reasoning_effort spellings 400 here — the raw string does
+    // not survive wire→IR lowering, and a typo must never silently buy a
+    // default tier (see `chat_request::validate_reasoning_effort`).
+    if let Err(msg) = req.validate_reasoning_effort() {
+        return openai_error_response(StatusCode::BAD_REQUEST, msg);
+    }
+
+    // Ollama-style: a request naming a different KNOWN model loads it first.
+    // Off unless `--auto-swap`, and `--no-auto-swap` overrides that; every
+    // other case (absent, unknown, already live) falls through untouched, which
+    // is byte-identical to the behaviour before this existed.
+    if host.auto_swap_enabled() {
+        let live = host.live_model().unwrap_or_default();
+        // Short-circuit the overwhelmingly common case — a client naming the
+        // model that is already loaded — before touching the disk. Reading the
+        // recipe index means an `ArtifactStore::discover` plus a JSON parse,
+        // and doing that per request put blocking I/O on a runtime worker in
+        // the hot path of every completion.
+        if !req.model.is_empty() && req.model != live {
+            let requested = req.model.clone();
+            let swap_host = host.clone();
+            // Both the catalogue read and the load are blocking, so BOTH belong
+            // off the runtime — the decision needs the index, and the index is
+            // on disk.
+            let outcome = tokio::task::spawn_blocking(move || {
+                let catalogue = atlas_plugin::ArtifactStore::discover()
+                    .ok()
+                    .map(|s| crate::recipe::fetch::cached(s.root()).recipes)
+                    .unwrap_or_default();
+                match crate::main_modules::auto_swap::decide(&requested, &live, &catalogue) {
+                    crate::main_modules::auto_swap::Decision::SwapTo(recipe_id) => {
+                        crate::main_modules::auto_swap::ensure_loaded(
+                            &swap_host, &recipe_id, &requested, &catalogue,
+                        )
+                    }
+                    // Unknown to the catalogue, or already live: serve as-is.
+                    crate::main_modules::auto_swap::Decision::ServeCurrent => Ok(()),
+                }
+            })
+            .await;
+            match outcome {
+                Ok(Ok(())) => {}
+                // A failed load already restored the previous model where it
+                // could; say so and serve on whatever is actually live rather
+                // than failing a request the old model could have answered.
+                Ok(Err(e)) => tracing::warn!("auto-swap to {:?} failed: {e:#}", req.model),
+                Err(e) => tracing::warn!("auto-swap task failed: {e}"),
+            }
+        }
+    }
+
+    // Resolve AFTER any swap, so the request is served by the model it asked
+    // for rather than the one that happened to be loaded when it arrived.
+    let Some(state) = host.current() else {
+        // `_typed`, not the plain form: the plain one derives `error.type` from
+        // the status and would label this `server_error`, which is both wrong
+        // (nothing failed) and inconsistent with the `CurrentModel` extractor,
+        // which reports `model_not_loaded` for the identical condition.
+        return crate::api::compact::openai_error_response_typed(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "no model is loaded".to_string(),
+            "model_not_loaded",
+        );
+    };
+
+    // --dump: record the incoming request body verbatim.
+    let dump_seq = state.dump_writer.as_ref().and_then(|d| {
+        match serde_json::from_slice::<serde_json::Value>(&body) {
+            Ok(v) => {
+                let seq = d.next_seq();
+                d.dump_request("/v1/chat/completions", seq, &v);
+                Some(seq)
+            }
+            Err(_) => None,
+        }
+    });
+
+    // Wire → IR at the edge: echo-only fields peel off beside the
+    // envelope; everything downstream reads only the IR.
+    let echo = ResponseEcho::from(&req);
+    let response_model =
+        crate::api::lora_control::response_model(&state, req.adapter.as_deref(), &req.model);
+    match chat_completions_inner(state.clone(), req_ctx, req.into(), dump_seq).await {
+        ChatOutcome::Blocking(ir) => {
+            crate::openai::encode_chat_response(&state, *ir, &echo, dump_seq)
+        }
+        ChatOutcome::Streaming(deltas) => {
+            crate::openai::encode_sse_response(deltas, response_model, echo.include_usage)
+        }
+        ChatOutcome::Http(r) => r,
+    }
+}
diff --git a/crates/spark-server/src/api/chat_blocking_tests.rs b/crates/spark-server/src/api/chat_blocking_tests.rs
new file mode 100644
index 0000000..186b404
--- /dev/null
+++ b/crates/spark-server/src/api/chat_blocking_tests.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+use super::stop_match_corrected;
+use crate::ir::{FINISH_REASON_TIMEOUT, FinishReason};
+
+#[test]
+fn matched_stop_corrects_length_to_stop() {
+    assert_eq!(
+        stop_match_corrected(FinishReason::Length, true),
+        FinishReason::Stop
+    );
+}
+
+#[test]
+fn everything_else_passes_through() {
+    // No match ⇒ a real budget stop stays "length".
+    assert_eq!(
+        stop_match_corrected(FinishReason::Length, false),
+        FinishReason::Length
+    );
+    // A match never rewrites tool_calls or the timeout contract.
+    assert_eq!(
+        stop_match_corrected(FinishReason::ToolCalls, true),
+        FinishReason::ToolCalls
+    );
+    assert_eq!(
+        stop_match_corrected(FinishReason::Other(FINISH_REASON_TIMEOUT.into()), true),
+        FinishReason::Other(FINISH_REASON_TIMEOUT.into())
+    );
+}
+
+use super::{
+    extract_hoisted_tool_calls, merge_hoisted_tool_calls, output_tokens_without_stop,
+    split_at_first_think_end,
+};
+use crate::tool_parser::{FunctionCall, ToolCall};
+
+fn tool_call(id: &str, city: &str) -> ToolCall {
+    ToolCall {
+        id: id.into(),
+        call_type: "function".into(),
+        function: FunctionCall {
+            name: "get_weather".into(),
+            arguments: format!(r#"{{"city":"{city}"}}"#),
+        },
+    }
+}
+
+#[test]
+fn duplicate_call_across_reasoning_and_content_is_emitted_once() {
+    let merged = merge_hoisted_tool_calls(
+        vec![tool_call("reasoning", "Boston")],
+        vec![tool_call("content", "Boston")],
+    );
+
+    assert_eq!(merged.len(), 1);
+    assert_eq!(merged[0].id, "content");
+}
+
+#[test]
+fn distinct_calls_across_reasoning_and_content_are_preserved() {
+    let merged = merge_hoisted_tool_calls(
+        vec![tool_call("reasoning", "Boston")],
+        vec![tool_call("content", "Seattle")],
+    );
+
+    assert_eq!(merged.len(), 2);
+}
+
+#[test]
+fn blocking_decode_excludes_terminal_stop_token() {
+    let tokens = [10, 11, 24];
+
+    assert_eq!(output_tokens_without_stop(&tokens, "stop"), &[10, 11]);
+    assert_eq!(output_tokens_without_stop(&tokens, "length"), &tokens);
+}
+
+#[test]
+fn blocking_thinking_split_uses_first_end_token() {
+    let tokens = [10, 19, 20, 19, 30];
+
+    let split = split_at_first_think_end(&tokens, 19, true);
+
+    assert_eq!(split, Some((&[10][..], &[20, 19, 30][..])));
+    assert_eq!(split_at_first_think_end(&tokens, 19, false), None);
+}
+
+#[test]
+fn poolside_tool_call_in_reasoning_is_not_hoisted() {
+    let reasoning = "plan <tool_call>write_file<arg_key>path</arg_key>\
+        <arg_value>/tmp/x</arg_value></tool_call> more";
+
+    let (preserved, calls) = extract_hoisted_tool_calls(Some(reasoning), Some("poolside_v1"));
+
+    assert_eq!(preserved.as_deref(), Some(reasoning));
+    assert!(calls.is_empty());
+}
+
+#[test]
+fn non_poolside_tool_call_in_reasoning_is_still_hoisted() {
+    let reasoning =
+        r#"plan <tool_call>{"name":"get_weather","arguments":{"city":"Boston"}}</tool_call>"#;
+
+    let (_scrubbed, calls) = extract_hoisted_tool_calls(Some(reasoning), Some("hermes"));
+
+    assert_eq!(calls.len(), 1);
+    assert_eq!(calls[0].function.name, "get_weather");
+}
diff --git a/crates/spark-server/src/api/completions_stream.rs b/crates/spark-server/src/api/completions_stream.rs
new file mode 100644
index 0000000..fe91c1b
--- /dev/null
+++ b/crates/spark-server/src/api/completions_stream.rs
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Legacy completions SSE execution and OpenAI wire framing.
+
+use axum::http::StatusCode;
+use axum::response::sse::{Event, KeepAlive};
+use axum::response::{IntoResponse, Response, Sse};
+use futures::StreamExt;
+use std::sync::Arc;
+use tokio_stream::wrappers::ReceiverStream;
+
+use super::inference_types::{InferenceRequest, StreamEvent};
+use crate::AppState;
+use crate::openai::{CompletionChunk, CompletionRequest, Usage};
+
+/// SSE streaming path for legacy completions (single prompt, n=1, handler-
+/// guarded). Echo: prompt text (+ logprobs when set) is the FIRST chunk; with
+/// `stream_options.include_usage` a `choices: []` usage chunk precedes `[DONE]`.
+pub(super) async fn completions_stream(
+    state: Arc<AppState>,
+    prompt_tokens: Vec<u32>,
+    req: CompletionRequest,
+    p: super::completions_exec::CompletionParams,
+) -> Result<Response, (StatusCode, String)> {
+    let model_name =
+        super::lora_control::response_model(&state, req.adapter.as_deref(), &req.model);
+    // Match chat_stream/mod.rs sizing; see comment there.
+    let (token_tx, token_rx) = tokio::sync::mpsc::channel::<StreamEvent>(1024);
+    let prompt_len = prompt_tokens.len();
+    let echo = req.echo;
+    let logprobs_k = p.logprobs_k;
+    let include_usage = req.stream_options.as_ref().is_some_and(|o| o.include_usage);
+    // Echo needs the prompt tokens after the request consumes them.
+    let echo_prompt = if echo {
+        Some(prompt_tokens.clone())
+    } else {
+        None
+    };
+    // Echo WITHOUT logprobs has no PromptLogprobs event to hook — the
+    // prompt text chunk is prepended client-side; decode it now, before
+    // the request takes ownership of the tokens.
+    let echo_only_text = if echo && logprobs_k.is_none() {
+        Some(state.tokenizer.decode(&prompt_tokens).unwrap_or_default())
+    } else {
+        None
+    };
+
+    let session_hash = crate::session_manager::compute_session_hash(&prompt_tokens);
+    let request = InferenceRequest::Streaming {
+        prompt_tokens: std::sync::Arc::new(prompt_tokens),
+        session_hash,
+        adapter_slot: p.adapter_slot,
+        src_lang_id: p.src_lang_id,
+        tgt_lang_id: p.tgt_lang_id,
+        num_beams: p.num_beams,
+        length_penalty: p.length_penalty,
+        early_stopping: p.early_stopping,
+        image_pixels: Vec::new(),
+        max_tokens: req.max_tokens,
+        min_tokens: 0,
+        temperature: p.temperature,
+        top_k: p.top_k,
+        top_p: p.top_p,
+        top_n_sigma: p.top_n_sigma,
+        min_p: p.min_p,
+        repetition_penalty: p.repetition_penalty,
+        presence_penalty: p.presence_penalty,
+        frequency_penalty: p.frequency_penalty,
+        // Legacy /v1/completions path doesn't have tool semantics.
+        dry_multiplier: 0.0,
+        dry_base: 1.75,
+        dry_allowed_length: 2,
+        lz_penalty: 0.0,
+        logit_bias: p.logit_bias,
+        stop_tokens: p.stop_tokens,
+        enable_thinking: false,
+        thinking_budget: None,
+        repetition_detection: p.repetition_detection,
+        require_tool_call: false,
+        // Completions API defines no tools — multi-tool-call continuation off.
+        tools_present: false,
+        suppress_tool_call: false,
+        disable_mtp: super::lora_control::disable_mtp(&state, p.adapter_slot),
+        grammar_spec: None,
+        seed: req.seed,
+        top_logprobs: logprobs_k,
+        prompt_logprobs: if echo { logprobs_k } else { None },
+        echo,
+        timeout_at: state.request_deadline(req.timeout),
+        token_tx,
+        // /v1/completions has no guard pipeline yet — the flag is
+        // created so the scheduler's emit_step type-checks cleanly,
+        // but never flipped.
+        cancel_flag: std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false)),
+    };
+
+    state.request_tx.send(request).await.map_err(|_| {
+        (
+            StatusCode::SERVICE_UNAVAILABLE,
+            "Scheduler queue full".to_string(),
+        )
+    })?;
+
+    let chunk_id = crate::openai::new_completion_id();
+    let model = model_name.clone();
+    let id = chunk_id.clone();
+    let mut all_toks: Vec<u32> = Vec::new();
+    let mut emitted: usize = 0;
+    // Incremental-detokenizer state (see `ChatTokenizer::incremental_decode`):
+    // extends `content_decoded` a bounded suffix at a time instead of
+    // re-decoding all_toks every token (O(n²) → O(n)).
+    let mut content_decoded = String::new();
+    let mut detok_prefix_offset: usize = 0;
+    let mut detok_read_offset: usize = 0;
+    let token_stream = ReceiverStream::new(token_rx).flat_map(move |event| {
+        let events: Vec<Result<Event, std::convert::Infallible>> = match event {
+            // Echo + logprobs: prompt text and its logprobs, before any
+            // generated token (the scheduler emits this exactly once).
+            StreamEvent::PromptLogprobs(lps) => {
+                let prompt_toks = echo_prompt.clone().unwrap_or_default();
+                let text = state.tokenizer.decode(&prompt_toks).unwrap_or_default();
+                let decode = |tid: u32| state.tokenizer.decode(&[tid]).unwrap_or_default();
+                let lp = super::completions_logprobs::build_completion_logprobs(
+                    &decode,
+                    true,
+                    &prompt_toks,
+                    &lps,
+                    &[],
+                    &[],
+                );
+                let chunk = CompletionChunk::echo_chunk(&model, &id, text, Some(lp));
+                vec![Ok(
+                    Event::default().data(serde_json::to_string(&chunk).unwrap_or_default())
+                )]
+            }
+            StreamEvent::Token(tok) | StreamEvent::TokenWithLogprobs(tok, _) => {
+                all_toks.push(tok);
+                content_decoded.push_str(&state.tokenizer.incremental_decode(
+                    &all_toks,
+                    &mut detok_prefix_offset,
+                    &mut detok_read_offset,
+                ));
+                let stable_end = content_decoded.len();
+                let delta = if stable_end <= emitted {
+                    String::new()
+                } else {
+                    let d = content_decoded[emitted..stable_end].to_string();
+                    emitted = stable_end;
+                    d
+                };
+                let chunk = CompletionChunk::text_chunk(&model, &id, delta);
+                vec![Ok(
+                    Event::default().data(serde_json::to_string(&chunk).unwrap_or_default())
+                )]
+            }
+            StreamEvent::Done {
+                finish_reason,
+                prompt_tokens: _,
+                completion_tokens,
+                time_to_first_token_ms,
+                decode_time_ms,
+                reasoning_tokens,
+                cached_prompt_tokens,
+                accepted_prediction_tokens,
+                guard_stop: _,
+            } => {
+                let tps = if decode_time_ms > 0.0 {
+                    completion_tokens.saturating_sub(1) as f64 / (decode_time_ms / 1000.0)
+                } else {
+                    0.0
+                };
+                let usage = Usage {
+                    prompt_tokens: prompt_len,
+                    completion_tokens,
+                    total_tokens: prompt_len + completion_tokens,
+                    prompt_tokens_details: Some(crate::openai::PromptTokensDetails {
+                        cached_tokens: cached_prompt_tokens as usize,
+                        audio_tokens: 0,
+                    }),
+                    completion_tokens_details: Some(crate::openai::CompletionTokensDetails {
+                        reasoning_tokens: reasoning_tokens as usize,
+                        audio_tokens: 0,
+                        accepted_prediction_tokens,
+                        rejected_prediction_tokens: 0,
+                    }),
+                    time_to_first_token_ms,
+                    response_tokens_per_second: tps,
+                };
+                if include_usage {
+                    // Chat parity: finish chunk without usage, then a
+                    // choices:[] usage-only chunk.
+                    let fin = CompletionChunk::finish_chunk_no_usage(&model, &id, &finish_reason);
+                    let usage_chunk = CompletionChunk::usage_only_chunk(&model, &id, usage);
+                    vec![
+                        Ok(Event::default().data(serde_json::to_string(&fin).unwrap_or_default())),
+                        Ok(Event::default()
+                            .data(serde_json::to_string(&usage_chunk).unwrap_or_default())),
+                    ]
+                } else {
+                    let chunk = CompletionChunk::done_chunk(&model, &id, &finish_reason, usage);
+                    vec![Ok(
+                        Event::default().data(serde_json::to_string(&chunk).unwrap_or_default())
+                    )]
+                }
+            }
+            StreamEvent::Error(msg) => {
+                vec![Ok(Event::default().data(format!(r#"{{"error":"{msg}"}}"#)))]
+            }
+        };
+        futures::stream::iter(events)
+    });
+
+    // Echo WITHOUT logprobs: the scheduler emits no PromptLogprobs event
+    // (nothing to collect), so prepend the prompt text chunk directly.
+    let echo_prefix: Option<Event> = echo_only_text.map(|text| {
+        let chunk = CompletionChunk::echo_chunk(&model_name, &chunk_id, text, None);
+        Event::default().data(serde_json::to_string(&chunk).unwrap_or_default())
+    });
+
+    let done_event = futures::stream::once(async {
+        Ok::<_, std::convert::Infallible>(Event::default().data("[DONE]"))
+    });
+    let prefix = futures::stream::iter(
+        echo_prefix
+            .into_iter()
+            .map(Ok::<_, std::convert::Infallible>),
+    );
+    let full_stream = prefix.chain(token_stream).chain(done_event);
+
+    Ok(Sse::new(full_stream)
+        .keep_alive(KeepAlive::default())
+        .into_response())
+}
diff --git a/crates/spark-server/src/api/lora_selection.rs b/crates/spark-server/src/api/lora_selection.rs
new file mode 100644
index 0000000..3fddd15
--- /dev/null
+++ b/crates/spark-server/src/api/lora_selection.rs
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Pure OpenAI model/adapter selection, including an explicit unadapted base.
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Selection<'a> {
+    Base,
+    Default,
+    Named(&'a str),
+}
+
+pub(super) fn select<'a>(
+    base_model: &str,
+    resident: &[String],
+    adapter: Option<&'a str>,
+    model: &'a str,
+    stageable: bool,
+) -> Selection<'a> {
+    if let Some(name) = adapter {
+        Selection::Named(name)
+    } else if model == base_model {
+        Selection::Base
+    } else if resident.iter().any(|name| name == model) || stageable {
+        Selection::Named(model)
+    } else {
+        Selection::Default
+    }
+}
+
+/// Match the response name to the selected model; legacy unknown aliases
+/// retain the served base name, as they did before request adapter routing.
+pub(super) fn response_model<'a>(
+    base_model: &'a str,
+    resident: &[String],
+    adapter: Option<&'a str>,
+    model: &'a str,
+    stageable: bool,
+) -> &'a str {
+    match select(base_model, resident, adapter, model, stageable) {
+        Selection::Base | Selection::Default => base_model,
+        Selection::Named(name) => name,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Selection, select};
+
+    #[test]
+    fn fixed_base_and_heretic_routes_are_distinct() {
+        let names = vec!["heretic".to_owned()];
+        assert_eq!(select("base", &names, None, "base", false), Selection::Base);
+        assert_eq!(
+            select("base", &names, None, "heretic", false),
+            Selection::Named("heretic")
+        );
+        assert_eq!(
+            select("base", &names, Some("heretic"), "base", false),
+            Selection::Named("heretic")
+        );
+        assert_eq!(
+            select("base", &names, Some("missing"), "base", false),
+            Selection::Named("missing")
+        );
+    }
+
+    #[test]
+    fn legacy_default_and_stageable_routes_are_preserved() {
+        assert_eq!(
+            select("base", &[], None, "legacy-alias", false),
+            Selection::Default
+        );
+        assert_eq!(
+            select("base", &[], None, "cold", true),
+            Selection::Named("cold")
+        );
+    }
+}
