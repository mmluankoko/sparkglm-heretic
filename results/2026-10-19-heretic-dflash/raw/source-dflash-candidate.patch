@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Real CUDA oracle for GLM rank-1, padded-8 dense and grouped LoRA kernels.
+//! No model weights, NCCL, graphs or server are needed. All K values below
+//! run decode (M=1), prefill, and grouped expert-down folds (hidden=4096).
+//! CPU references accumulate in FP32 and round each stored stage to BF16.
+//! Gate: every value finite and |got-ref| <= ATOL + RTOL*magnitude;
+//! fold magnitude is |base|+|scale*delta| to handle cancellation explicitly.
+//! Padded XA and skipped/unadapted output rows also have exact checks.
+//!
+//! ATLAS_TARGET_HW=gb10 ATLAS_TARGET_MODEL=glm-5.3-flash \
+//! ATLAS_TARGET_QUANT=nvfp4 cargo run --release -p spark-model \
+//!   --features cuda,gpu-examples --example glm_heretic_lora_math -- 17 31 0
+//! Args: prefill rows (2..64), grouped window (1..144), GPU ordinal.
+
+#[cfg(not(feature = "cuda"))]
+fn main() -> anyhow::Result<()> {
+    anyhow::bail!("glm_heretic_lora_math requires the cuda feature and a CUDA GPU")
+}
+
+#[cfg(feature = "cuda")]
+fn main() -> anyhow::Result<()> {
+    cuda::run()
+}
+
+#[cfg(feature = "cuda")]
+mod cuda {
+    use anyhow::{Context, Result, ensure};
+    use half::bf16;
+    use spark_model::layers::ops::lora_delta::{LoraKernels, LoraPair, apply_lora_delta};
+    use spark_model::layers::ops::{MoeExpertRoute, moe_lora_grouped_down, pack_expert_tables};
+    use spark_model::weight_map::DenseWeight;
+    use spark_runtime::cuda_backend::AtlasCudaBackend;
+    use spark_runtime::gpu::{DevicePtr, GpuBackend};
+
+    const H: usize = 4096;
+    const R: usize = 8;
+    const TE: usize = 144;
+    const TOKENS: usize = 72;
+    const ATOL: f32 = 2e-5;
+    const RTOL: f32 = 0.015625;
+    const GUARD: u16 = 0x3f00;
+
+    struct Rng(u64);
+    impl Rng {
+        fn value(&mut self, amplitude: f32) -> u16 {
+            self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1);
+            let unit = (self.0 >> 40) as f32 / (1u64 << 24) as f32;
+            bits((2.0 * unit - 1.0) * amplitude)
+        }
+        fn values(&mut self, count: usize, amplitude: f32) -> Vec<u16> {
+            (0..count).map(|_| self.value(amplitude)).collect()
+        }
+    }
+
+    fn value(bits: u16) -> f32 {
+        bf16::from_bits(bits).to_f32()
+    }
+    fn bits(value: f32) -> u16 {
+        bf16::from_f32(value).to_bits()
+    }
+    fn rounded(v: f32) -> f32 {
+        value(bits(v))
+    }
+
+    // Own and release each case's allocations, including on a failed oracle.
+    struct Arena<'a> {
+        gpu: &'a dyn GpuBackend,
+        owned: Vec<DevicePtr>,
+    }
+    impl<'a> Arena<'a> {
+        fn new(gpu: &'a dyn GpuBackend) -> Self {
+            Self {
+                gpu,
+                owned: Vec::new(),
+            }
+        }
+        fn bytes(&mut self, bytes: &[u8]) -> Result<DevicePtr> {
+            let p = self.gpu.alloc(bytes.len().max(16))?;
+            self.owned.push(p);
+            self.gpu.copy_h2d(bytes, p)?;
+            Ok(p)
+        }
+        fn bf16(&mut self, data: &[u16]) -> Result<DevicePtr> {
+            self.bytes(
+                &data
+                    .iter()
+                    .flat_map(|v| v.to_le_bytes())
+                    .collect::<Vec<_>>(),
+            )
+        }
+        fn read(&self, p: DevicePtr, count: usize) -> Result<Vec<u16>> {
+            let mut bytes = vec![0; count * 2];
+            self.gpu.copy_d2h(p, &mut bytes)?;
+            Ok(bytes
+                .chunks_exact(2)
+                .map(|v| u16::from_le_bytes([v[0], v[1]]))
+                .collect())
+        }
+    }
+    impl Drop for Arena<'_> {
+        fn drop(&mut self) {
+            let _ = self.gpu.synchronize(self.gpu.default_stream());
+            for ptr in self.owned.drain(..).rev() {
+                let _ = self.gpu.free(ptr);
+            }
+        }
+    }
+
+    struct Pair {
+        a: Vec<u16>,
+        b: Vec<u16>,
+        scale: f32,
+    }
+    impl Pair {
+        fn new(k: usize, scale: f32, rng: &mut Rng) -> Self {
+            let mut a = vec![0; R * k];
+            a[..k].copy_from_slice(&rng.values(k, 0.125));
+            let mut b = vec![0; H * R];
+            for row in 0..H {
+                b[row * R] = rng.value(0.5);
+            }
+            Self { a, b, scale }
+        }
+        fn upload(&self, arena: &mut Arena<'_>, k: usize) -> Result<LoraPair> {
+            Ok(LoraPair {
+                a: DenseWeight {
+                    weight: arena.bf16(&self.a)?,
+                },
+                b: DenseWeight {
+                    weight: arena.bf16(&self.b)?,
+                },
+                rank: 1,
+                k_in: k as u32,
+                n_out: H as u32,
+                scale: self.scale,
+                max_rank: R as u32,
+            })
+        }
+        fn shrink(&self, x: &[u16]) -> f32 {
+            let mut sum = 0.0f32;
+            for (&x, &a) in x.iter().zip(&self.a) {
+                sum += value(x) * value(a);
+            }
+            rounded(sum)
+        }
+        fn delta(&self, xa: f32, col: usize) -> f32 {
+            rounded(xa * value(self.b[col * R]))
+        }
+    }
+
+    fn compare(label: &str, got: &[u16], want: &[f32], magnitudes: Option<&[f32]>) -> Result<()> {
+        ensure!(
+            !got.is_empty() && got.len() == want.len(),
+            "{label}: invalid comparison lengths"
+        );
+        ensure!(
+            magnitudes.is_none_or(|m| m.len() == want.len()),
+            "{label}: magnitude length mismatch"
+        );
+        let (mut bad, mut max_abs, mut max_ratio) = (0, 0.0f32, 0.0f32);
+        for (i, (&g, &w)) in got.iter().zip(want).enumerate() {
+            let g = value(g);
+            let mag = magnitudes.map_or(w.abs(), |m| m[i]);
+            ensure!(
+                g.is_finite() && w.is_finite() && mag.is_finite(),
+                "{label}: nonfinite at {i}: got={g} want={w} magnitude={mag}"
+            );
+            let error = (g - w).abs();
+            let budget = ATOL + RTOL * mag;
+            max_abs = max_abs.max(error);
+            max_ratio = max_ratio.max(error / budget);
+            if error > budget {
+                if bad == 0 {
+                    eprintln!(
+                        "{label}: first mismatch {i}: got={g} want={w} abs={error} budget={budget}"
+                    );
+                }
+                bad += 1;
+            }
+        }
+        println!(
+            "{label}: samples={} bad={bad} max_abs={max_abs:.6e} max_budget_ratio={max_ratio:.4}",
+            got.len()
+        );
+        ensure!(
+            bad == 0,
+            "{label}: {bad} values exceed atol={ATOL} rtol={RTOL}"
+        );
+        Ok(())
+    }
+
+    fn check_padding(xa: &[u16]) -> Result<()> {
+        ensure!(
+            xa.chunks_exact(R).all(|r| r[1..].iter().all(|&v| v == 0)),
+            "rank padding is not exactly zero"
+        );
+        Ok(())
+    }
+
+    fn dense(gpu: &dyn GpuBackend, kernels: &LoraKernels, k: usize, m: usize) -> Result<()> {
+        let label = format!("dense K={k} M={m}");
+        let mut rng = Rng(0x51a7 + k as u64 + m as u64);
+        let pair = Pair::new(k, 0.75, &mut rng);
+        let x = rng.values(m * k, 0.25);
+        let initial = rng.values(m * H, 0.015625);
+        let mut arena = Arena::new(gpu);
+        let p = pair.upload(&mut arena, k)?;
+        let dx = arena.bf16(&x)?;
+        let out = arena.bf16(&initial)?;
+        let xa = arena.bf16(&vec![0x7fc0; m * R])?;
+        let delta = arena.bf16(&vec![0x7fc0; m * H])?;
+        apply_lora_delta(
+            gpu,
+            kernels,
+            &p,
+            dx,
+            out,
+            m as u32,
+            xa,
+            delta,
+            gpu.default_stream(),
+        )?;
+        gpu.synchronize(gpu.default_stream())?;
+        let (mut xa_ref, mut delta_ref, mut out_ref, mut mag) = (
+            vec![0.0; m * R],
+            vec![0.0; m * H],
+            vec![0.0; m * H],
+            vec![0.0; m * H],
+        );
+        for row in 0..m {
+            let shrink = pair.shrink(&x[row * k..(row + 1) * k]);
+            xa_ref[row * R] = shrink;
+            for col in 0..H {
+                let i = row * H + col;
+                let d = pair.delta(shrink, col);
+                let base = value(initial[i]);
+                delta_ref[i] = d;
+                out_ref[i] = rounded(base + pair.scale * d);
+                mag[i] = base.abs() + (pair.scale * d).abs();
+            }
+        }
+        let got_xa = arena.read(xa, m * R)?;
+        check_padding(&got_xa)?;
+        compare(&format!("{label} shrink"), &got_xa, &xa_ref, None)?;
+        compare(
+            &format!("{label} expand"),
+            &arena.read(delta, m * H)?,
+            &delta_ref,
+            None,
+        )?;
+        compare(
+            &format!("{label} fold"),
+            &arena.read(out, m * H)?,
+            &out_ref,
+            Some(&mag),
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn grouped(
+        gpu: &dyn GpuBackend,
+        kernels: &LoraKernels,
+        k: usize,
+        cap: usize,
+        masked: bool,
+        gather: bool,
+        all_base: bool,
+        truncated: bool,
+    ) -> Result<Vec<u16>> {
+        let label = format!(
+            "grouped K={k} window={cap} masked={masked} gather={gather} all_base={all_base} truncated={truncated} compact={}",
+            kernels.moe_compact_enabled
+        );
+        let mut rng = Rng(0xa11ce + k as u64);
+        // Expert 3 has 65 rows; empty experts repeat offsets, expert 4 is unadapted.
+        let offsets = [0i32, 0, 1, 1, 66, 137, TE as i32, TE as i32];
+        // A valid top-2 route: each token occurs twice, once per expert.
+        let sorted: Vec<i32> = std::iter::once(0)
+            .chain(0..65)
+            .chain(1..TOKENS as i32)
+            .chain(65..TOKENS as i32)
+            .collect();
+        let row_map: Vec<i32> = (0..TOKENS)
+            .map(|t| if all_base || t % 3 == 0 { -1 } else { 0 })
+            .collect();
+        let pairs: Vec<Option<Pair>> = [None, Some(0.75), None, Some(-0.5), None, Some(1.25), None]
+            .into_iter()
+            .map(|s| s.map(|s| Pair::new(k, s, &mut rng)))
+            .collect();
+        let x = rng.values((if gather { TOKENS } else { TE }) * k, 0.25);
+        let initial = rng.values(TE * H, 0.015625);
+        let mut arena = Arena::new(gpu);
+        let mut entries = Vec::new();
+        for (e, pair) in pairs.iter().enumerate() {
+            if let Some(pair) = pair.as_ref().filter(|_| !truncated || e < 4) {
+                let p = pair.upload(&mut arena, k)?;
+                entries.push((e as u16, p.a.weight.0, p.b.weight.0, p.scale));
+            }
+        }
+        let tables = pack_expert_tables(&entries).context("empty grouped expert tables")?;
+        let route = MoeExpertRoute {
+            a_table: arena.bytes(
+                &tables
+                    .a
+                    .iter()
+                    .flat_map(|v| v.to_le_bytes())
+                    .collect::<Vec<_>>(),
+            )?,
+            b_table: arena.bytes(
+                &tables
+                    .b
+                    .iter()
+                    .flat_map(|v| v.to_le_bytes())
+                    .collect::<Vec<_>>(),
+            )?,
+            scale_table: arena.bytes(
+                &tables
+                    .scale
+                    .iter()
+                    .flat_map(|v| v.to_le_bytes())
+                    .collect::<Vec<_>>(),
+            )?,
+            n_experts: tables.n_experts,
+            k_in: k as u32,
+            n_out: H as u32,
+            max_rank: R as u32,
+        };
+        let dx = arena.bf16(&x)?;
+        let out = arena.bf16(&initial)?;
+        let eoff = arena.bytes(
+            &offsets
+                .iter()
+                .flat_map(|v| v.to_le_bytes())
+                .collect::<Vec<_>>(),
+        )?;
+        let ids = arena.bytes(
+            &sorted
+                .iter()
+                .flat_map(|v| v.to_le_bytes())
+                .collect::<Vec<_>>(),
+        )?;
+        let map = arena.bytes(
+            &row_map
+                .iter()
+                .flat_map(|v| v.to_le_bytes())
+                .collect::<Vec<_>>(),
+        )?;
+        let scratch_init = vec![GUARD; (cap + 2) * R];
+        let scratch = arena.bf16(&scratch_init)?;
+        let xa = scratch.offset(R * 2);
+        let mut want: Vec<f32> = initial.iter().map(|&b| value(b)).collect();
+        let mut mag: Vec<f32> = want.iter().map(|v| v.abs()).collect();
+        let mut shrinks = vec![0.0; TE];
+        let mut adapted = vec![false; TE];
+        for (e, pair) in pairs.iter().enumerate() {
+            let Some(pair) = pair.as_ref().filter(|_| e < route.n_experts as usize) else {
+                continue;
+            };
+            for row in offsets[e] as usize..offsets[e + 1] as usize {
+                if masked && row_map[sorted[row] as usize] < 0 {
+                    continue;
+                }
+                adapted[row] = true;
+                let xr = if gather { sorted[row] as usize } else { row };
+                let shrink = pair.shrink(&x[xr * k..(xr + 1) * k]);
+                shrinks[row] = shrink;
+                for col in 0..H {
+                    let i = row * H + col;
+                    let d = pair.scale * pair.delta(shrink, col);
+                    mag[i] += d.abs();
+                    want[i] = rounded(want[i] + d);
+                }
+            }
+        }
+        // The actual production launcher uses absolute sorted rows but local XA.
+        for off in (0..TE).step_by(cap) {
+            let end = (off + cap).min(TE);
+            gpu.copy_h2d(
+                &scratch_init
+                    .iter()
+                    .flat_map(|v| v.to_le_bytes())
+                    .collect::<Vec<_>>(),
+                scratch,
+            )?;
+            moe_lora_grouped_down(
+                gpu,
+                kernels,
+                &route,
+                dx,
+                out,
+                eoff,
+                ids,
+                if masked { map } else { DevicePtr::NULL },
+                xa,
+                off as u32,
+                end as u32,
+                u32::from(gather),
+                gpu.default_stream(),
+            )?;
+            gpu.synchronize(gpu.default_stream())?;
+            let got = arena.read(scratch, (cap + 2) * R)?;
+            ensure!(
+                got[..R]
+                    .iter()
+                    .chain(&got[(cap + 1) * R..])
+                    .all(|&v| v == GUARD),
+                "{label}: XA guard overwritten"
+            );
+            let (mut active_got, mut active_want) = (Vec::new(), Vec::new());
+            for row in off..end {
+                if adapted[row] {
+                    let local = (row - off + 1) * R;
+                    check_padding(&got[local..local + R])?;
+                    active_got.push(got[local]);
+                    active_want.push(shrinks[row]);
+                }
+            }
+            if !active_got.is_empty() {
+                compare(
+                    &format!("{label} shrink [{off},{end})"),
+                    &active_got,
+                    &active_want,
+                    None,
+                )?;
+            }
+        }
+        let got = arena.read(out, TE * H)?;
+        for row in 0..TE {
+            if !adapted[row] {
+                ensure!(
+                    got[row * H..(row + 1) * H] == initial[row * H..(row + 1) * H],
+                    "{label}: base/unadapted row {row} changed"
+                );
+            }
+        }
+        ensure!(
+            ((all_base && masked) || adapted.iter().any(|a| *a)) && adapted.iter().any(|a| !*a),
+            "grouped coverage is empty"
+        );
+        compare(&format!("{label} fold"), &got, &want, Some(&mag))?;
+        Ok(got)
+    }
+
+    mod compact_oracle {
+        include!("glm_heretic_lora_math/compact.rs");
+    }
+
+    mod pair_oracle {
+        include!("glm_heretic_lora_math/pair.rs");
+    }
+
+    pub(super) fn run() -> Result<()> {
+        let args: Vec<String> = std::env::args().skip(1).collect();
+        ensure!(
+            args.len() <= 3,
+            "usage: glm_heretic_lora_math [prefill_rows=17] [window=31] [gpu=0]"
+        );
+        let parse = |i: usize, default: usize| -> Result<usize> {
+            args.get(i).map_or(Ok(default), |s| {
+                s.parse().with_context(|| format!("invalid argument {s}"))
+            })
+        };
+        let (rows, cap, ordinal) = (parse(0, 17)?, parse(1, 31)?, parse(2, 0)?);
+        ensure!(
+            (2..=64).contains(&rows) && (1..=TE).contains(&cap),
+            "prefill rows must be 2..64 and window 1..144"
+        );
+        let backend = AtlasCudaBackend::new(ordinal, &atlas_kernels::ptx_modules())?;
+        let gpu: &dyn GpuBackend = &backend;
+        let kernels = LoraKernels::new(gpu)?;
+        println!(
+            "rank=1 padded={R} hidden={H} prefill_rows={rows} window={cap} atol={ATOL} rtol={RTOL}"
+        );
+        for k in [1024, 2048, 4096, 8192] {
+            dense(gpu, &kernels, k, 1)?;
+            dense(gpu, &kernels, k, rows)?;
+            grouped(gpu, &kernels, k, TE, false, false, false, false)?;
+            grouped(gpu, &kernels, k, cap, true, false, false, false)?;
+        }
+        compact_oracle::run(gpu, &kernels)?;
+        pair_oracle::run(gpu, &kernels)?;
+        println!(
+            "PASS: 16 general GPU cases, 10 compact/original pairs and 32 direct-pair/m1 cases; finite/padding/skip/guard checks"
+        );
+        Ok(())
+    }
+}
