@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Conservative GLM shared-down side path. The original shared output is
+//! computed once on each rank, then the existing EP blend adds it once.
+
+use super::*;
+use crate::layer::MoeLoraRoute;
+use crate::layers::ops::lora_delta::{LoraKernels, LoraPair, apply_lora_delta};
+
+pub(crate) struct SharedLoraWeights {
+    full: LoraPair,
+    /// Retained for a future shared-TP optimized Heretic path; the initial
+    /// implementation deliberately uses the complete shared expert.
+    _split: Option<LoraPair>,
+    kernels: LoraKernels,
+}
+
+impl MoeLayer {
+    pub(crate) fn set_shared_lora_weights(
+        &mut self,
+        full: Option<LoraPair>,
+        split: Option<LoraPair>,
+        kernels: LoraKernels,
+        _gpu: &dyn GpuBackend,
+    ) -> Result<()> {
+        self.shared_lora = match full {
+            Some(full) => {
+                anyhow::ensure!(
+                    full.rank == 1 && full.k_in == 2048 && full.n_out == 4096,
+                    "unsupported GLM shared LoRA geometry"
+                );
+                Some(SharedLoraWeights {
+                    full,
+                    _split: split,
+                    kernels,
+                })
+            }
+            None => None,
+        };
+        Ok(())
+    }
+
+    pub(super) fn shared_heretic_active(&self, ctx: &ForwardContext) -> Result<bool> {
+        if self.shared_lora.is_none() {
+            return Ok(false);
+        }
+        crate::layers::glm_lora::active(ctx)
+    }
+
+    pub(super) fn run_shared_heretic(
+        &self,
+        input: DevicePtr,
+        rows: u32,
+        hidden: u32,
+        inter: u32,
+        ctx: &ForwardContext,
+        stream: u64,
+    ) -> Result<()> {
+        let lora = self
+            .shared_lora
+            .as_ref()
+            .ok_or_else(|| anyhow::anyhow!("missing shared delta"))?;
+        anyhow::ensure!(
+            matches!(
+                ctx.moe_lora_route,
+                MoeLoraRoute::Fold | MoeLoraRoute::FoldDflash
+            ),
+            "shared delta called for a base request"
+        );
+        anyhow::ensure!(
+            hidden == lora.full.n_out && inter == lora.full.k_in,
+            "shared expert local geometry mismatch"
+        );
+        let gate = ctx.buffers.ssm_deinterleaved();
+        let up = ctx.buffers.ssm_qkvz();
+        let output = ctx.buffers.attn_output();
+        let tc = crate::layers::w4a16_gemv_tiers::tc_kernel(rows);
+        if matches!(ctx.moe_lora_route, MoeLoraRoute::FoldDflash)
+            && rows <= crate::layers::canonical_verify::MAX_ROWS
+            && crate::layers::canonical_verify::enabled()
+            && tc.0 != 0
+        {
+            self.run_shared_tc(
+                tc, input, gate, up, output, rows, hidden, inter, ctx, stream,
+            )?;
+        } else {
+            for (weight, destination) in [
+                (&self.weights.shared_expert.gate_proj, gate),
+                (&self.weights.shared_expert.up_proj, up),
+            ] {
+                ops::w4a16_gemm(
+                    ctx.gpu,
+                    self.w4a16_gemm,
+                    input,
+                    weight,
+                    destination,
+                    rows,
+                    inter,
+                    hidden,
+                    stream,
+                )?;
+            }
+            ops::silu_mul(
+                ctx.gpu,
+                self.moe_act_mul,
+                gate,
+                up,
+                gate,
+                rows * inter,
+                stream,
+            )?;
+            ops::w4a16_gemm(
+                ctx.gpu,
+                self.w4a16_gemm,
+                gate,
+                &self.weights.shared_expert.down_proj,
+                output,
+                rows,
+                hidden,
+                inter,
+                stream,
+            )?;
+        }
+        anyhow::ensure!(
+            ctx.buffers.lora_xa_bytes() >= rows as usize * lora.full.max_rank as usize * 2
+                && ctx.buffers.lora_delta_bytes() >= rows as usize * hidden as usize * 2,
+            "shared LoRA arena too small"
+        );
+        if matches!(ctx.moe_lora_route, MoeLoraRoute::FoldDflash) {
+            anyhow::ensure!(
+                crate::layers::glm_lora::dflash_context(ctx, rows as usize),
+                "invalid Heretic DFlash shared context"
+            );
+            return ops::lora_pair_rows::apply(
+                ctx.gpu,
+                &lora.kernels,
+                &lora.full,
+                gate,
+                output,
+                rows,
+                ctx.buffers.lora_xa(),
+                stream,
+            );
+        }
+        apply_lora_delta(
+            ctx.gpu,
+            &lora.kernels,
+            &lora.full,
+            gate,
+            output,
+            rows,
+            ctx.buffers.lora_xa(),
+            ctx.buffers.lora_delta(),
+            stream,
+        )
+    }
+}
diff --git a/crates/spark-model/src/layers/ops/lora_pair_rows.rs b/crates/spark-model/src/layers/ops/lora_pair_rows.rs
