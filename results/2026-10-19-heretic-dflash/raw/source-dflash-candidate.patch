+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Frozen HTTP policy after resolving the actual adapter pool slot.
+
+pub(super) fn disabled(legacy_disabled: bool, heretic_admitted: bool, slot: i32) -> bool {
+    legacy_disabled && !(heretic_admitted && slot == 0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::disabled;
+
+    #[test]
+    fn only_explicit_base_or_admitted_real_heretic_slot_can_speculate() {
+        for admitted in [false, true] {
+            for slot in [-3, -2, -1, 0, 1, i32::MAX] {
+                assert!(!disabled(false, admitted, slot));
+                assert_eq!(
+                    disabled(slot != -2, admitted, slot),
+                    !(slot == -2 || (admitted && slot == 0))
+                );
+            }
+        }
+    }
+}
diff --git a/crates/spark-server/src/api/stop_sequences.rs b/crates/spark-server/src/api/stop_sequences.rs
new file mode 100644
index 0000000..9b36291
--- /dev/null
+++ b/crates/spark-server/src/api/stop_sequences.rs
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! String stop handling after token decoding, including stops inside tokens.
+
+pub(crate) fn strip_stop_sequences(text: String, stops: &[String]) -> String {
+    strip_stop_sequences_matched(text, stops).0
+}
+
+pub(crate) fn strip_stop_sequences_matched(
+    mut text: String,
+    stops: &[String],
+) -> (String, Option<String>) {
+    let first = stops
+        .iter()
+        .filter(|stop| !stop.is_empty())
+        .filter_map(|stop| text.find(stop.as_str()).map(|position| (position, stop)))
+        .min_by_key(|(position, stop)| (*position, std::cmp::Reverse(stop.len())));
+    if let Some((position, stop)) = first {
+        text.truncate(position);
+        return (text, Some(stop.clone()));
+    }
+    (text, None)
+}
+
+pub(crate) fn finish_reason_after_stop(reason: String, matched: bool) -> String {
+    if matched && reason == "length" {
+        "stop".to_owned()
+    } else {
+        reason
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn stops(values: &[&str]) -> Vec<String> {
+        values.iter().map(|value| (*value).to_owned()).collect()
+    }
+
+    #[test]
+    fn newline_inside_a_multi_newline_token_ends_the_completion() {
+        assert_eq!(
+            strip_stop_sequences_matched("42\n\nQuestion: another example".into(), &stops(&["\n"])),
+            ("42".into(), Some("\n".into()))
+        );
+    }
+
+    #[test]
+    fn first_stop_wins_regardless_of_list_order() {
+        assert_eq!(
+            strip_stop_sequences_matched("答复。STOPmoreEND".into(), &stops(&["END", "STOP"])),
+            ("答复。".into(), Some("STOP".into()))
+        );
+    }
+
+    #[test]
+    fn longest_stop_at_same_position_identifies_the_complete_match() {
+        for values in [["</answer", "</answer>"], ["</answer>", "</answer"]] {
+            assert_eq!(
+                strip_stop_sequences_matched("yes</answer>tail".into(), &stops(&values)),
+                ("yes".into(), Some("</answer>".into()))
+            );
+        }
+    }
+
+    #[test]
+    fn absent_and_empty_stops_preserve_output() {
+        for values in [vec![], stops(&[""]), stops(&["missing"])] {
+            assert_eq!(
+                strip_stop_sequences_matched("answer".into(), &values),
+                ("answer".into(), None)
+            );
+        }
+    }
+
+    #[test]
+    fn suffix_and_complete_output_stops_still_work() {
+        assert_eq!(
+            strip_stop_sequences("answerEND".into(), &stops(&["END"])),
+            "answer"
+        );
+        assert_eq!(strip_stop_sequences("END".into(), &stops(&["END"])), "");
+    }
+
+    #[test]
+    fn truncation_corrects_length_without_overriding_other_terminal_causes() {
+        assert_eq!(finish_reason_after_stop("length".into(), true), "stop");
+        for reason in ["stop", "timeout", "tool_calls"] {
+            assert_eq!(finish_reason_after_stop(reason.into(), true), reason);
+        }
+        assert_eq!(finish_reason_after_stop("length".into(), false), "length");
+    }
+}
diff --git a/crates/spark-server/src/main_modules/serve_load/lora_dflash_launch.rs b/crates/spark-server/src/main_modules/serve_load/lora_dflash_launch.rs
